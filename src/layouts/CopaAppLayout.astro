---
import "../styles/global.css";
import Analytics from "../components/Analytics.astro";

interface Props {
  title?: string;
  description?: string;
  requireAuth?: boolean;
}

const {
  title = "Copa Oautos 2026",
  description = "Plataforma privada de la Copa Oautos 2026",
  requireAuth = false,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/src/assets/favicon-oautos.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <Analytics />
  </head>
  <body class="min-h-dvh bg-[#0D2C4D] text-white antialiased">
    {requireAuth && (
      <script is:inline>
        (function () {
          if (!localStorage.getItem("copa_auth_token")) {
            window.location.replace("/copa-oautos-2026/login");
          }
        })();
      </script>
    )}
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
    overflow-x: hidden;
  }
</style>
