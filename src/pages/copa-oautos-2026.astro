---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/landings/copa-oautos-2026/Hero.astro';
import SectionNav from '../components/landings/copa-oautos-2026/SectionNav.astro';
import Rewards from '../components/landings/copa-oautos-2026/Rewards.astro';
import About from '../components/landings/copa-oautos-2026/About.astro';
import CtaBanner from '../components/shared/CtaBanner.astro';
import HowItWorks from '../components/landings/como-funciona/HowItWorks.astro';
import Tiers from '../components/landings/copa-oautos-2026/Tiers.astro';
import Prizes from '../components/landings/copa-oautos-2026/Prizes.astro';
import Dynamics from '../components/landings/copa-oautos-2026/Dynamics.astro';
import Faq from '../components/shared/Faq.astro';
import FinalCta from '../components/landings/copa-oautos-2026/FinalCta.astro';
import Footer from '../components/shared/Footer.astro';
import { content } from '../content/copa-oautos-2026';

const navItems = [
  { label: 'Recompensas', href: '#copa-rewards' },
  { label: 'Qué es', href: '#copa-about' },
  { label: 'Cómo funciona', href: '#como-funciona' },
  { label: 'Niveles', href: '#copa-tiers' },
  { label: 'Premios', href: '#copa-prizes' },
  { label: 'Dinámicas', href: '#copa-dynamics' },
  { label: 'FAQ', href: '#faq' },
];
---

<Layout
  title={content.meta.title}
  description={content.meta.description}
  showNavbar={false}
>
  <main>
    <Hero {...content.hero} />
    <SectionNav items={navItems} />
    <Rewards {...content.rewards} />
    <About {...content.about} />
    <CtaBanner {...content.bannerCta} />
    <HowItWorks title={content.howItWorks.title} steps={content.howItWorks.items} />
    <Tiers {...content.tiers} />
    <Prizes {...content.prizes} />
    <Dynamics {...content.dynamics} />
    <Faq {...content.faq} />
    <FinalCta {...content.finalCta} />
  </main>

  <Footer {...content.footer} />
</Layout>
