---
import CopaAppLayout from "../../layouts/CopaAppLayout.astro";
import logoOautos from "../../assets/logoOautos-copa.png";
import { content } from "../../content/copa-oautos-2026-app";

const { recuperarPassword } = content;
const { sent } = recuperarPassword;
---

<CopaAppLayout title={sent.meta.title} description={sent.meta.description}>
  <section
    class="relative min-h-dvh w-full flex items-center justify-center overflow-hidden px-5 py-12"
  >
    <div
      class="absolute inset-0 bg-gradient-to-br from-[#0D2C4D] via-[#117CD9] to-[#0D2C4D]"
      aria-hidden="true"
    >
    </div>
    <div class="absolute inset-0 bg-black/40" aria-hidden="true"></div>

    <div
      class="relative z-10 w-full max-w-lg bg-white text-gray-900 rounded-3xl shadow-2xl px-7 sm:px-10 py-10"
    >
      <div class="text-center mb-6">
        <div class="inline-flex items-center justify-center mb-6">
          <img src={logoOautos.src} alt="Oautos" class="h-9 w-auto" />
        </div>

        <span
          class="inline-flex h-16 w-16 items-center justify-center rounded-full bg-emerald-100 text-emerald-700 mb-4"
          aria-hidden="true"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="w-8 h-8"
          >
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
            <path d="m9 11 3 3L22 4" />
          </svg>
        </span>

        <span
          class="block text-xs font-semibold uppercase tracking-[0.2em] text-emerald-700 mb-2"
        >
          {sent.eyebrow}
        </span>

        <h1 class="text-2xl sm:text-3xl font-extrabold leading-tight mb-3">
          {sent.title}
        </h1>

        <p
          id="copa-recovery-sent-subtitle"
          class="text-sm sm:text-base text-gray-600 leading-relaxed"
        >
          {sent.subtitleGeneric}
        </p>
      </div>

      <div
        class="bg-gray-50 border border-gray-100 rounded-2xl p-4 sm:p-5 mb-6"
      >
        <p class="text-sm font-bold text-[#0D2C4D] mb-1.5 flex items-center gap-2">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="w-4 h-4 text-[#117CD9]"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10" />
            <path d="M12 16v-4" />
            <path d="M12 8h.01" />
          </svg>
          {sent.helperTitle}
        </p>
        <p class="text-sm text-gray-600 leading-relaxed">
          {sent.helperText}
        </p>
      </div>

      <a
        href="/copa-oautos-2026/login"
        class="block w-full px-10 py-3 rounded-full text-base font-semibold border-2 border-[#117CD9] bg-[#117CD9] text-white hover:bg-[#0D5FB3] hover:border-[#0D5FB3] transition-all duration-300 text-center"
      >
        {sent.backToLoginButton}
      </a>

      <p
        id="copa-recovery-countdown"
        class="mt-4 text-center text-xs text-gray-500"
      >
      </p>
    </div>
  </section>
</CopaAppLayout>

<script
  is:inline
  define:vars={{
    subtitleWithEmail: sent.subtitleWithEmail,
    subtitleGeneric: sent.subtitleGeneric,
    redirectMessage: sent.redirectMessage,
    redirectSeconds: sent.redirectSeconds,
    loginPath: "/copa-oautos-2026/login",
  }}
>
  (() => {
    // === Sustituir email en el subtitle si viene por query ===
    const subtitleEl = document.getElementById("copa-recovery-sent-subtitle");
    const countdownEl = document.getElementById("copa-recovery-countdown");

    try {
      const params = new URLSearchParams(window.location.search);
      const email = (params.get("email") || "").trim();
      if (email && subtitleEl) {
        subtitleEl.innerHTML = subtitleWithEmail.replace(
          "{email}",
          `<span class="font-semibold text-[#0D2C4D]">${email}</span>`,
        );
      }
    } catch (_) {
      /* Sin params, dejar texto genérico. */
    }

    // === Countdown + redirect automático al login ===
    let remaining = Math.max(1, Number(redirectSeconds) || 15);
    const tick = () => {
      if (!countdownEl) return;
      countdownEl.textContent = redirectMessage.replace(
        "{seconds}",
        String(remaining),
      );
    };
    tick();
    const interval = setInterval(() => {
      remaining -= 1;
      if (remaining <= 0) {
        clearInterval(interval);
        window.location.href = loginPath;
        return;
      }
      tick();
    }, 1000);

    // Si el usuario interactúa (scroll/click) detenemos el redirect automático.
    const cancelAuto = () => {
      clearInterval(interval);
      if (countdownEl) countdownEl.textContent = "";
    };
    document.addEventListener("click", cancelAuto, { once: true });
    document.addEventListener("scroll", cancelAuto, {
      once: true,
      passive: true,
    });
  })();
</script>
