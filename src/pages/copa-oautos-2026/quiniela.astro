---
import CopaAppLayout from "../../layouts/CopaAppLayout.astro";
import AppNavbar from "../../components/copa-oautos-2026-app/AppNavbar.astro";
import QuinielaHeader from "../../components/copa-oautos-2026-app/quiniela/QuinielaHeader.astro";
import QuinielaMainTabs from "../../components/copa-oautos-2026-app/quiniela/QuinielaMainTabs.astro";
import QuinielaPhases from "../../components/copa-oautos-2026-app/quiniela/QuinielaPhases.astro";
import QuinielaMatchCard from "../../components/copa-oautos-2026-app/quiniela/QuinielaMatchCard.astro";
import QuinielaGroupFilter from "../../components/copa-oautos-2026-app/quiniela/QuinielaGroupFilter.astro";
import QuinielaPointsModal from "../../components/copa-oautos-2026-app/quiniela/QuinielaPointsModal.astro";
import QuinielaTournamentPicks from "../../components/copa-oautos-2026-app/quiniela/QuinielaTournamentPicks.astro";
import { content } from "../../content/copa-oautos-2026-app";
import { QUINIELA_ENDPOINTS } from "../../lib/api";

const { quiniela, navbar } = content;

// Helpers para agrupar partidos por día calendario en hora CDMX (audiencia mexicana).
// Mantenemos una sola TZ canónica para que servidor y cliente coincidan.
const CDMX_TZ = "America/Mexico_City";

const dateKeyFmt = new Intl.DateTimeFormat("en-CA", {
  timeZone: CDMX_TZ,
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
});
const dateLabelFmt = new Intl.DateTimeFormat("es-MX", {
  timeZone: CDMX_TZ,
  weekday: "long",
  day: "numeric",
  month: "long",
});
const getDateKey = (iso: string) => dateKeyFmt.format(new Date(iso));
const getDateLabel = (iso: string) => dateLabelFmt.format(new Date(iso));

const matchesByPhase = quiniela.phases.map((phase) => {
  const phaseMatches = quiniela.matches
    .filter((m) => m.phaseId === phase.id)
    .sort(
      (a, b) => new Date(a.kickoff).getTime() - new Date(b.kickoff).getTime(),
    );

  const dateGroups: { key: string; label: string; matches: typeof phaseMatches }[] = [];
  for (const match of phaseMatches) {
    const key = getDateKey(match.kickoff);
    let bucket = dateGroups.find((g) => g.key === key);
    if (!bucket) {
      bucket = { key, label: getDateLabel(match.kickoff), matches: [] };
      dateGroups.push(bucket);
    }
    bucket.matches.push(match);
  }

  return { phase, matches: phaseMatches, dateGroups };
});

const firstOpenPhaseId =
  quiniela.phases.find((p) => p.status === "open")?.id ?? quiniela.phases[0]?.id;

// Lista única de países participantes (extraída de los matches), ordenada alfabéticamente
// en español. Se pasa al selector de país de Apuestas Mundialistas.
const teamMap = new Map<string, { code: string; name: string }>();
for (const match of quiniela.matches) {
  if (!teamMap.has(match.teamA.code)) {
    teamMap.set(match.teamA.code, match.teamA);
  }
  if (!teamMap.has(match.teamB.code)) {
    teamMap.set(match.teamB.code, match.teamB);
  }
}
const countries = Array.from(teamMap.values()).sort((a, b) =>
  a.name.localeCompare(b.name, "es"),
);

// Grupos disponibles en fase de grupos (para el filtro).
const groupCodes = Array.from(
  new Set(
    quiniela.matches
      .filter((m) => m.phaseId === "grupos" && m.group)
      .map((m) => (m.group ?? "").replace(/^Grupo\s+/, "")),
  ),
).sort();

// Puntos relevantes para el script (cálculo en partidos finalizados).
const matchPointsConfig = {
  exact:
    quiniela.pointsTable.rules.find((r) => r.label === "Marcador exacto")
      ?.points ?? 150,
  outcome:
    quiniela.pointsTable.rules.find((r) => r.label === "Ganador correcto")
      ?.points ?? 50,
  favorite:
    quiniela.pointsTable.rules.find((r) => r.label === "Equipo favorito gana")
      ?.points ?? 25,
};
---

<CopaAppLayout
  title={quiniela.meta.title}
  description={quiniela.meta.description}
  requireAuth
>
  <AppNavbar content={navbar} />
  <main class="bg-[#F4F7FB] min-h-[calc(100dvh-4rem)]">
    <QuinielaHeader
      header={quiniela.header}
      rules={quiniela.rules}
      backLabel={quiniela.labels.backToDashboard}
      backHref={navbar.homeHref}
    />

    <QuinielaMainTabs tabs={quiniela.mainTabs} activeId="partidos" />

    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 py-6 sm:py-8">
      <!-- TAB: Partidos -->
      <section
        id="copa-quiniela-main-partidos"
        role="tabpanel"
        aria-labelledby="copa-quiniela-main-tab-partidos"
        data-main-tab-panel="partidos"
        class="space-y-6"
      >
        <QuinielaPhases phases={quiniela.phases} />

        {
          matchesByPhase.map(({ phase, matches, dateGroups }) => {
            const isActive = phase.id === firstOpenPhaseId;
            const showGroupFilter = phase.id === "grupos" && matches.length > 0;
            return (
              <section
                id={`copa-quiniela-panel-${phase.id}`}
                role="tabpanel"
                aria-labelledby={`copa-quiniela-tab-${phase.id}`}
                data-phase-panel={phase.id}
                data-phase-status={phase.status}
                class:list={["space-y-4", !isActive && "hidden"]}
              >
                {phase.status === "locked" ? (
                  <div class="bg-white rounded-2xl ring-1 ring-gray-200 px-5 py-8 sm:py-10 text-center shadow-sm">
                    <span
                      class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-gray-100 text-gray-500 mb-3"
                      aria-hidden="true"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="w-6 h-6"
                      >
                        <rect
                          width="18"
                          height="11"
                          x="3"
                          y="11"
                          rx="2"
                          ry="2"
                        />
                        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                      </svg>
                    </span>
                    <h3 class="text-base sm:text-lg font-bold text-[#0D2C4D] mb-1.5">
                      {quiniela.labels.phaseLockedTitle}
                    </h3>
                    <p class="text-sm text-gray-600 max-w-md mx-auto leading-relaxed">
                      {phase.lockedMessage ?? quiniela.labels.phaseLockedHint}
                    </p>
                  </div>
                ) : matches.length === 0 ? (
                  <div class="bg-white rounded-2xl ring-1 ring-gray-200 px-5 py-8 text-center text-sm text-gray-600 shadow-sm">
                    {quiniela.labels.phaseEmpty}
                  </div>
                ) : (
                  <>
                    {showGroupFilter && (
                      <QuinielaGroupFilter groups={groupCodes} />
                    )}
                    <div class="space-y-6">
                      {dateGroups.map((dg) => (
                        <div data-date-group={dg.key} class="space-y-3">
                          <div class="flex items-baseline gap-2 px-1">
                            <h3 class="text-sm sm:text-base font-extrabold text-[#0D2C4D] capitalize">
                              {dg.label}
                            </h3>
                            <span
                              data-date-count
                              data-singular="1 partido"
                              data-plural-suffix="partidos"
                              class="text-xs sm:text-sm text-gray-500 font-medium"
                            >
                              {dg.matches.length === 1
                                ? "1 partido"
                                : `${dg.matches.length} partidos`}
                            </span>
                          </div>
                          <div class="space-y-3 sm:space-y-4">
                            {dg.matches.map((match) => (
                              <QuinielaMatchCard
                                match={match}
                                labels={quiniela.labels}
                                pointsRules={quiniela.pointsTable.rules}
                                cutoffHours={phase.cutoffHours}
                              />
                            ))}
                          </div>
                        </div>
                      ))}
                    </div>
                  </>
                )}
              </section>
            );
          })
        }
      </section>

      <!-- TAB: Apuestas mundialistas -->
      <section
        id="copa-quiniela-main-apuestas"
        role="tabpanel"
        aria-labelledby="copa-quiniela-main-tab-apuestas"
        data-main-tab-panel="apuestas"
        class="space-y-6 hidden"
      >
        <QuinielaTournamentPicks
          content={quiniela.tournamentPicks}
          countries={countries}
        />
      </section>
    </div>
  </main>

  <QuinielaPointsModal content={quiniela.pointsTable} />
</CopaAppLayout>

<script
  is:inline
  define:vars={{
    pointsConfig: matchPointsConfig,
    pointsKey: "copa-quiniela-predictions-v1",
    phaseStorageKey: "copa-quiniela-phase-v1",
    tournamentPicksKey: "copa-quiniela-tournament-picks-v1",
    mainTabStorageKey: "copa-quiniela-main-tab-v1",
    groupFilterKey: "copa-quiniela-group-filter-v1",
    endpointMyPredictions: QUINIELA_ENDPOINTS.myPredictions,
    endpointBulkPredictions: QUINIELA_ENDPOINTS.bulkPredictions,
    endpointMvp: QUINIELA_ENDPOINTS.mvp,
    endpointGoleador: QUINIELA_ENDPOINTS.goleador,
    endpointFavoriteTeam: QUINIELA_ENDPOINTS.favoriteTeam,
    endpointChampionTeam: QUINIELA_ENDPOINTS.championTeam,
  }}
>
  (() => {
    // === Main tabs (Partidos / Apuestas mundialistas) ===
    const mainTablist = document.getElementById("copa-quiniela-main-tablist");
    const mainTabs = mainTablist
      ? Array.from(mainTablist.querySelectorAll(".copa-main-tab"))
      : [];
    const mainPanels = Array.from(
      document.querySelectorAll("[data-main-tab-panel]"),
    );

    const activateMainTab = (tabId) => {
      mainTabs.forEach((tab) => {
        const isActive = tab.dataset.mainTabId === tabId;
        tab.setAttribute("aria-selected", isActive ? "true" : "false");
        tab.classList.remove(
          "border-[#117CD9]",
          "text-[#117CD9]",
          "border-transparent",
          "text-gray-500",
          "hover:text-[#117CD9]",
        );
        if (isActive) {
          tab.classList.add("border-[#117CD9]", "text-[#117CD9]");
        } else {
          tab.classList.add(
            "border-transparent",
            "text-gray-500",
            "hover:text-[#117CD9]",
          );
        }
        const iconWrap = tab.querySelector("span[aria-hidden='true']");
        if (iconWrap) {
          iconWrap.classList.remove(
            "bg-[#117CD9]/10",
            "text-[#117CD9]",
            "bg-gray-100",
            "text-gray-500",
          );
          if (isActive) {
            iconWrap.classList.add("bg-[#117CD9]/10", "text-[#117CD9]");
          } else {
            iconWrap.classList.add("bg-gray-100", "text-gray-500");
          }
        }
      });
      mainPanels.forEach((panel) => {
        panel.classList.toggle(
          "hidden",
          panel.dataset.mainTabPanel !== tabId,
        );
      });
      try {
        localStorage.setItem(mainTabStorageKey, tabId);
      } catch (_) {}
    };

    mainTabs.forEach((tab) => {
      tab.addEventListener("click", () => activateMainTab(tab.dataset.mainTabId));
    });

    try {
      const savedMainTab = localStorage.getItem(mainTabStorageKey);
      if (savedMainTab && mainTabs.some((t) => t.dataset.mainTabId === savedMainTab)) {
        activateMainTab(savedMainTab);
      }
    } catch (_) {}

    // === Phase tabs ===
    const tablist = document.getElementById("copa-quiniela-tablist");
    const tabs = tablist
      ? Array.from(tablist.querySelectorAll(".copa-phase-tab"))
      : [];
    const panels = Array.from(
      document.querySelectorAll("[data-phase-panel]"),
    );

    const activateTab = (phaseId) => {
      tabs.forEach((tab) => {
        const isActive = tab.dataset.phaseId === phaseId;
        const isLocked = tab.dataset.phaseStatus === "locked";
        tab.setAttribute("aria-selected", isActive ? "true" : "false");
        tab.classList.remove(
          "bg-[#117CD9]",
          "border-[#117CD9]",
          "text-white",
          "shadow",
          "bg-white",
          "border-gray-200",
          "text-gray-600",
          "hover:border-[#117CD9]",
          "hover:text-[#117CD9]",
          "bg-gray-50",
          "text-gray-400",
        );
        if (isActive) {
          tab.classList.add(
            "bg-[#117CD9]",
            "border-[#117CD9]",
            "text-white",
            "shadow",
          );
        } else if (isLocked) {
          tab.classList.add("bg-gray-50", "border-gray-200", "text-gray-400");
        } else {
          tab.classList.add(
            "bg-white",
            "border-gray-200",
            "text-gray-600",
            "hover:border-[#117CD9]",
            "hover:text-[#117CD9]",
          );
        }
      });
      panels.forEach((panel) => {
        panel.classList.toggle(
          "hidden",
          panel.dataset.phasePanel !== phaseId,
        );
      });
      try {
        localStorage.setItem(phaseStorageKey, phaseId);
      } catch (_) {}
    };

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        if (tab.dataset.phaseStatus === "locked") {
          activateTab(tab.dataset.phaseId);
          return;
        }
        activateTab(tab.dataset.phaseId);
      });
    });

    try {
      const saved = localStorage.getItem(phaseStorageKey);
      if (saved && tabs.some((t) => t.dataset.phaseId === saved)) {
        activateTab(saved);
      }
    } catch (_) {}

    // === Predicciones persistentes ===
    const loadAllPredictions = () => {
      try {
        const raw = localStorage.getItem(pointsKey);
        return raw ? JSON.parse(raw) : {};
      } catch (_) {
        return {};
      }
    };
    const saveAllPredictions = (data) => {
      try {
        localStorage.setItem(pointsKey, JSON.stringify(data));
        return true;
      } catch (_) {
        return false;
      }
    };

    let predictions = loadAllPredictions();

    // Tracks which matchIds the user has manually edited this session (prevents
    // the API init load from overwriting in-progress user input).
    const userModifiedCards = new Set();

    // === Formato de fecha/cuenta regresiva ===
    // Hora CDMX como referencia única para la audiencia mexicana.
    const dateFmt = new Intl.DateTimeFormat("es-MX", {
      timeZone: "America/Mexico_City",
      weekday: "long",
      day: "numeric",
      month: "long",
      hour: "2-digit",
      minute: "2-digit",
      hour12: false,
    });

    const formatKickoff = (iso) => {
      try {
        return dateFmt.format(new Date(iso));
      } catch (_) {
        return iso;
      }
    };

    // === Lógica de puntos por partido ===
    // Tabla 2026: marcador exacto (150), ganador correcto / empate correcto (50), sin acierto (0).
    // Bono "equipo favorito gana" se computa aparte cuando tengamos al equipo seleccionado.
    const computePoints = (predA, predB, realA, realB) => {
      if (predA == null || predB == null || Number.isNaN(predA) || Number.isNaN(predB)) {
        return { points: null, reason: "no-prediction" };
      }
      if (predA === realA && predB === realB) {
        return { points: pointsConfig.exact, reason: "exact" };
      }
      const predOutcome = Math.sign(predA - predB);
      const realOutcome = Math.sign(realA - realB);
      if (predOutcome === realOutcome) {
        return { points: pointsConfig.outcome, reason: "outcome" };
      }
      return { points: 0, reason: "miss" };
    };

    // === Render por tarjeta ===
    const cards = Array.from(document.querySelectorAll(".copa-match-card"));

    const cardCutoffMs = (card) => {
      const hours = Number(card.dataset.cutoffHours) || 24;
      return hours * 60 * 60 * 1000;
    };

    const setStatusBadge = (card, status) => {
      const badge = card.querySelector(".copa-match-status");
      if (!badge) return;
      const map = {
        open: {
          text: badge.dataset.statusOpen,
          classes: ["bg-emerald-100", "text-emerald-700"],
        },
        locked: {
          text: badge.dataset.statusLocked,
          classes: ["bg-amber-100", "text-amber-800"],
        },
        finished: {
          text: badge.dataset.statusFinished,
          classes: ["bg-gray-200", "text-gray-700"],
        },
      };
      badge.classList.remove(
        "bg-emerald-100",
        "text-emerald-700",
        "bg-amber-100",
        "text-amber-800",
        "bg-gray-200",
        "text-gray-700",
      );
      const cfg = map[status];
      cfg.classes.forEach((c) => badge.classList.add(c));
      badge.textContent = cfg.text;
    };

    const refreshCard = (card) => {
      const matchId = card.dataset.matchId;
      const kickoff = new Date(card.dataset.kickoff);
      const now = new Date();
      const finished = card.dataset.finished === "1";

      const cutoffLabel = card.querySelector(".copa-match-cutoff");
      const inputs = Array.from(card.querySelectorAll(".copa-match-input"));
      const pointsEl = card.querySelector(".copa-match-points");

      // Mostrar la fecha legible en el encabezado.
      const kickoffLabel = card.querySelector("[data-match-kickoff-label]");
      if (kickoffLabel) kickoffLabel.textContent = formatKickoff(kickoff);

      if (finished) {
        setStatusBadge(card, "finished");
        // Bloquear inputs.
        inputs.forEach((input) => {
          input.disabled = true;
        });
        // Calcular puntos vs predicción guardada.
        if (pointsEl) {
          const realA = Number(card.dataset.resultA);
          const realB = Number(card.dataset.resultB);
          const pred = predictions[matchId];
          if (pred && pred.a !== undefined && pred.b !== undefined) {
            // Restaurar la predicción para visualizarla.
            inputs[0].value = pred.a;
            inputs[1].value = pred.b;
            const { points, reason } = computePoints(
              Number(pred.a),
              Number(pred.b),
              realA,
              realB,
            );
            const earnedLabel = pointsEl.dataset.pointsLabel;
            const noPtsLabel = pointsEl.dataset.noPointsLabel;
            if (points > 0) {
              pointsEl.innerHTML = `
                <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-emerald-100 text-emerald-700">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><path d="M20 6 9 17l-5-5"/></svg>
                  +${points} ${earnedLabel}
                </span>`;
            } else {
              pointsEl.innerHTML = `
                <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-gray-200 text-gray-600">
                  ${noPtsLabel}
                </span>`;
            }
          } else {
            pointsEl.innerHTML = `<span class="text-gray-400">${pointsEl.dataset.noPredictionLabel}</span>`;
          }
        }
        return;
      }

      // Partido aún no finalizado.
      const cutoffTime = new Date(kickoff.getTime() - cardCutoffMs(card));
      const isLocked = now.getTime() >= cutoffTime.getTime();

      // Restaurar valores guardados, si existen.
      const pred = predictions[matchId];
      if (pred) {
        if (inputs[0] && pred.a !== undefined && inputs[0].value === "") {
          inputs[0].value = pred.a;
        }
        if (inputs[1] && pred.b !== undefined && inputs[1].value === "") {
          inputs[1].value = pred.b;
        }
      }

      inputs.forEach((input) => {
        input.disabled = isLocked;
      });

      if (isLocked) {
        setStatusBadge(card, "locked");
        if (cutoffLabel) {
          cutoffLabel.textContent = cutoffLabel.dataset.cutoffPassed;
          cutoffLabel.classList.add("text-amber-700", "font-semibold");
        }
      } else {
        setStatusBadge(card, "open");
        if (cutoffLabel) {
          cutoffLabel.classList.remove("text-amber-700", "font-semibold");
          cutoffLabel.textContent = `${cutoffLabel.dataset.cutoffPrefix} ${formatKickoff(cutoffTime)}`;
        }
      }
    };

    const handleInputChange = (card) => {
      const matchId = card.dataset.matchId;
      const inputs = Array.from(card.querySelectorAll(".copa-match-input"));
      const feedback = card.querySelector(".copa-match-save-feedback");
      const a = inputs[0]?.value === "" ? null : Number(inputs[0]?.value);
      const b = inputs[1]?.value === "" ? null : Number(inputs[1]?.value);

      // Mark as user-edited so the API load won't overwrite it.
      userModifiedCards.add(matchId);

      predictions[matchId] = { a, b, savedAt: new Date().toISOString() };
      saveAllPredictions(predictions);

      // Persist to API (debounced 800 ms so we don't spam on every keystroke).
      clearTimeout(card._apiTimeout);
      card._apiTimeout = setTimeout(() => {
        if (a === null || b === null) return;
        const token = localStorage.getItem("copa_auth_token");
        if (!token) return;
        fetch(endpointBulkPredictions, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "Authorization": "Bearer " + token,
          },
          body: JSON.stringify({
            predictions: [{ matchId, goalsA: a, goalsB: b }],
          }),
        }).catch(() => {});
      }, 800);

      if (feedback) {
        feedback.classList.remove("hidden", "text-red-600", "text-emerald-600");
        feedback.textContent = `✓ ${feedback.dataset.savedLabel}`;
        feedback.classList.add("text-emerald-600");
        clearTimeout(card._feedbackTimeout);
        card._feedbackTimeout = setTimeout(() => {
          feedback.classList.add("hidden");
        }, 2500);
      }
    };

    cards.forEach((card) => {
      refreshCard(card);
      const inputs = Array.from(card.querySelectorAll(".copa-match-input"));
      inputs.forEach((input) => {
        input.addEventListener("input", () => {
          // Sanitizar a 0..20.
          let v = parseInt(input.value, 10);
          if (Number.isNaN(v)) {
            input.value = "";
          } else if (v < 0) {
            input.value = "0";
          } else if (v > 20) {
            input.value = "20";
          }
          handleInputChange(card);
        });
      });
    });

    // Refrescar estados cada minuto por si el cutoff vence durante la sesión.
    setInterval(() => {
      cards.forEach(refreshCard);
    }, 60 * 1000);

    // === Predicciones de torneo (MVP / goleador / equipo favorito / campeón) ===
    const tournamentSection = document.querySelector("[data-tournament-picks]");
    if (tournamentSection) {
      const deadlineIso = tournamentSection.dataset.deadline;
      const deadlineLabel = tournamentSection.querySelector(
        ".copa-tournament-deadline",
      );
      const feedback = tournamentSection.querySelector(
        ".copa-tournament-feedback",
      );

      // Seleccionar todos los inputs con data-pick-id: tanto los de texto (kind=text)
      // como los hidden de los selectores de país (kind=country).
      const pickInputs = Array.from(
        tournamentSection.querySelectorAll("[data-pick-id]"),
      );

      // También deshabilitar/habilitar el trigger button de los selectores de país.
      const countryTriggers = Array.from(
        tournamentSection.querySelectorAll("[data-country-trigger]"),
      );

      const updateDeadline = () => {
        if (!deadlineIso || !deadlineLabel) return;
        const deadline = new Date(deadlineIso);
        const now = new Date();
        const isPassed = now.getTime() >= deadline.getTime();
        pickInputs.forEach((input) => { input.disabled = isPassed; });
        countryTriggers.forEach((btn) => { btn.disabled = isPassed; });
        if (isPassed) {
          deadlineLabel.textContent =
            tournamentSection.dataset.deadlinePassed ?? "Cerrado";
          deadlineLabel.classList.add("text-amber-700", "font-semibold");
        } else {
          deadlineLabel.textContent = `${tournamentSection.dataset.deadlinePrefix} ${formatKickoff(deadline)}`;
          deadlineLabel.classList.remove("text-amber-700", "font-semibold");
        }
      };

      updateDeadline();
      setInterval(updateDeadline, 60 * 1000);

      let feedbackTimeout = null;
      const flashFeedback = () => {
        if (!feedback) return;
        feedback.textContent = `✓ ${tournamentSection.dataset.savedLabel}`;
        feedback.classList.remove("hidden");
        clearTimeout(feedbackTimeout);
        feedbackTimeout = setTimeout(() => {
          feedback.classList.add("hidden");
        }, 2000);
      };

      pickInputs.forEach((input) => {
        input.addEventListener("input", () => {
          const id = input.dataset.pickId;
          const kind = input.dataset.pickKind; // 'text' | 'country'
          if (!id) return;

          // Mark as user-modified so the API load won't overwrite.
          input._userModified = true;
          flashFeedback();

          // Persist to API (debounced 800 ms).
          clearTimeout(input._apiTimeout);
          input._apiTimeout = setTimeout(() => {
            const token = localStorage.getItem("copa_auth_token");
            if (!token) return;

            if (kind === "country") {
              // Hidden input: value = country code, dataset.selectedName = display name.
              const teamName = (input.dataset.selectedName || "").trim();
              if (!teamName) return;
              const endpoint =
                id === "favorito"
                  ? endpointFavoriteTeam
                  : id === "campeon"
                    ? endpointChampionTeam
                    : null;
              if (!endpoint) return;
              fetch(endpoint, {
                method: "POST",
                headers: {
                  "Content-Type": "application/json",
                  "Authorization": "Bearer " + token,
                },
                body: JSON.stringify({ teamName }),
              }).catch(() => {});
            } else {
              // Text input: value = player name.
              const value = input.value.trim();
              if (!value) return;
              const endpoint =
                id === "mvp"
                  ? endpointMvp
                  : id === "goleador"
                    ? endpointGoleador
                    : null;
              if (!endpoint) return;
              fetch(endpoint, {
                method: "POST",
                headers: {
                  "Content-Type": "application/json",
                  "Authorization": "Bearer " + token,
                },
                body: JSON.stringify({ playerName: value }),
              }).catch(() => {});
            }
          }, 800);
        });
      });
    }

    // === Filtro por grupo (sólo en fase de grupos) ===
    const filterBar = document.querySelector("[data-group-filter-bar]");
    if (filterBar) {
      const chips = Array.from(filterBar.querySelectorAll(".copa-group-chip"));
      const resetBtn = filterBar.querySelector("[data-group-filter-reset]");
      const dateGroupNodes = Array.from(
        document.querySelectorAll("[data-date-group]"),
      );

      const applyFilter = (groupId) => {
        const target = groupId ?? "all";

        chips.forEach((chip) => {
          const isActive = chip.dataset.groupFilter === target;
          chip.setAttribute("aria-selected", isActive ? "true" : "false");
          chip.classList.remove(
            "bg-[#117CD9]",
            "border-[#117CD9]",
            "text-white",
            "bg-white",
            "border-gray-200",
            "text-gray-600",
            "hover:border-[#117CD9]",
            "hover:text-[#117CD9]",
          );
          if (isActive) {
            chip.classList.add(
              "bg-[#117CD9]",
              "border-[#117CD9]",
              "text-white",
            );
          } else {
            chip.classList.add(
              "bg-white",
              "border-gray-200",
              "text-gray-600",
              "hover:border-[#117CD9]",
              "hover:text-[#117CD9]",
            );
          }
        });

        if (resetBtn) {
          resetBtn.classList.toggle("hidden", target === "all");
        }

        // Mostrar/ocultar partidos y actualizar conteos por fecha.
        dateGroupNodes.forEach((dateNode) => {
          const cards = Array.from(
            dateNode.querySelectorAll("[data-match-group]"),
          );
          let visibleCount = 0;
          cards.forEach((card) => {
            const matchGroup = card.dataset.matchGroup;
            const shouldShow = target === "all" || matchGroup === target;
            card.classList.toggle("hidden", !shouldShow);
            if (shouldShow) visibleCount += 1;
          });
          const countEl = dateNode.querySelector("[data-date-count]");
          if (countEl) {
            countEl.textContent =
              visibleCount === 1
                ? countEl.dataset.singular ?? "1 partido"
                : `${visibleCount} ${countEl.dataset.pluralSuffix ?? "partidos"}`;
          }
          dateNode.classList.toggle("hidden", visibleCount === 0);
        });

        try {
          if (target === "all") {
            localStorage.removeItem(groupFilterKey);
          } else {
            localStorage.setItem(groupFilterKey, target);
          }
        } catch (_) {}
      };

      chips.forEach((chip) => {
        chip.addEventListener("click", () =>
          applyFilter(chip.dataset.groupFilter),
        );
      });

      if (resetBtn) {
        resetBtn.addEventListener("click", () => applyFilter("all"));
      }

      try {
        const saved = localStorage.getItem(groupFilterKey);
        if (
          saved &&
          chips.some((c) => c.dataset.groupFilter === saved)
        ) {
          applyFilter(saved);
        }
      } catch (_) {}
    }

    // === Carga inicial desde la API ===
    // Se ejecuta una sola vez al cargar la página. No dispara guardados a la API
    // (solo hidrata los inputs desde el GET) para evitar bucles de escritura.
    (() => {
      const token = localStorage.getItem("copa_auth_token");
      if (!token) return;

      fetch(endpointMyPredictions, {
        headers: { "Authorization": "Bearer " + token },
      })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (!data || !data.success || !data.data || !data.data.save) return;
          const save = data.data.save;

          // --- Predicciones de partidos ---
          // La API es la fuente de verdad: reemplazar predictions por completo.
          // Solo se conservan las entradas editadas manualmente en esta sesión.
          if (Array.isArray(save.matchPredictions)) {
            // Construir mapa desde la respuesta del API.
            const apiMap = {};
            save.matchPredictions.forEach(function (mp) {
              apiMap[mp.matchId] = { a: mp.goalsA, b: mp.goalsB };
            });

            // Nuevo objeto: entradas del API + lo que el usuario editó esta sesión.
            const next = {};
            userModifiedCards.forEach(function (matchId) {
              if (predictions[matchId]) next[matchId] = predictions[matchId];
            });
            Object.keys(apiMap).forEach(function (matchId) {
              if (!userModifiedCards.has(matchId)) {
                next[matchId] = apiMap[matchId];
              }
            });

            predictions = next;
            saveAllPredictions(predictions);

            // Hidratar inputs: asignar valor de API o limpiar si no viene en el response.
            cards.forEach(function (card) {
              if (userModifiedCards.has(card.dataset.matchId)) return;
              if (card.dataset.finished === "1") return;
              const matchId = card.dataset.matchId;
              const inputs = Array.from(card.querySelectorAll(".copa-match-input"));
              const pred = predictions[matchId];
              if (inputs[0]) inputs[0].value = pred != null ? (pred.a ?? "") : "";
              if (inputs[1]) inputs[1].value = pred != null ? (pred.b ?? "") : "";
            });
          }

          // --- Tournament picks (MVP / goleador / equipo favorito / campeón) ---
          const tp = save.tournamentPicks;
          if (tp && tournamentSection) {
            // Texto (mvp, goleador)
            [["mvp", tp.mvp], ["goleador", tp.goleador]].forEach(function (pair) {
              var pickId = pair[0];
              var entry = pair[1];
              var input = tournamentSection.querySelector('[data-pick-id="' + pickId + '"]');
              if (!input || input._userModified) return;
              var val = entry && typeof entry === "object" ? entry.playerName : entry;
              if (val) input.value = val;
            });

            // País (favorito, campeon) — se hidrata a través del selector de banderas.
            [["favorito", tp.favoriteTeam], ["campeon", tp.championTeam]].forEach(function (pair) {
              var pickId = pair[0];
              var entry = pair[1];
              if (!entry) return;
              var teamName = entry.teamName || "";
              if (!teamName) return;
              var hiddenInput = tournamentSection.querySelector('[data-pick-id="' + pickId + '"]');
              if (hiddenInput && hiddenInput._userModified) return;
              // Encontrar la opción cuyo nombre coincida y activar el setter expuesto por el componente.
              var selectRoot = tournamentSection.querySelector('[data-country-select="' + pickId + '"]');
              if (!selectRoot) return;
              var options = Array.from(selectRoot.querySelectorAll("[data-country-option]"));
              var match = options.find(function (o) { return o.dataset.countryName === teamName; });
              if (match && typeof selectRoot._setCountryValue === "function") {
                selectRoot._setCountryValue(match.dataset.countryOption, match.dataset.countryName);
              }
            });
          }
        })
        .catch(function () {});
    })();
  })();
</script>
