---
import CopaAppLayout from "../../layouts/CopaAppLayout.astro";
import logoOautos from "../../assets/logoOautos-copa.png";
import { content } from "../../content/copa-oautos-2026-app";

const { recuperarPassword } = content;
const { request } = recuperarPassword;
---

<CopaAppLayout
  title={recuperarPassword.meta.title}
  description={recuperarPassword.meta.description}
>
  <section
    class="relative min-h-dvh w-full flex items-center justify-center overflow-hidden px-5 py-12"
  >
    <!-- Fondo gradiente de marca -->
    <div
      class="absolute inset-0 bg-gradient-to-br from-[#0D2C4D] via-[#117CD9] to-[#0D2C4D]"
      aria-hidden="true"
    >
    </div>
    <div class="absolute inset-0 bg-black/40" aria-hidden="true"></div>

    <div
      class="relative z-10 w-full max-w-lg bg-white text-gray-900 rounded-3xl shadow-2xl px-7 sm:px-10 py-10"
    >
      <div class="text-center mb-8">
        <div class="inline-flex items-center justify-center mb-6">
          <img src={logoOautos.src} alt="Oautos" class="h-9 w-auto" />
        </div>

        <span
          class="block text-xs font-semibold uppercase tracking-[0.2em] text-[#117CD9] mb-2"
        >
          {request.eyebrow}
        </span>

        <h1 class="text-2xl sm:text-3xl font-extrabold leading-tight mb-3">
          {request.title}
        </h1>

        <p class="text-sm sm:text-base text-gray-600 leading-relaxed">
          {request.subtitle}
        </p>
      </div>

      <form
        id="copa-recovery-form"
        class="space-y-5"
        novalidate
        autocomplete="on"
      >
        <div>
          <label
            for="copa-recovery-email"
            class="block text-sm font-semibold text-gray-800 mb-1.5"
          >
            {request.emailLabel}
          </label>
          <input
            id="copa-recovery-email"
            name="email"
            type="email"
            inputmode="email"
            autocomplete="email"
            required
            placeholder={request.emailPlaceholder}
            class="w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-base text-gray-900 placeholder:text-gray-400 focus:outline-none focus:border-[#117CD9] focus:ring-2 focus:ring-[#117CD9]/30 transition"
          />
        </div>

        <p
          id="copa-recovery-error"
          role="alert"
          class="hidden text-sm text-red-600 bg-red-50 border border-red-100 rounded-lg px-3 py-2"
        >
        </p>

        <button
          type="submit"
          class="block w-full px-10 py-3 rounded-full text-base font-semibold border-2 border-[#117CD9] bg-[#117CD9] text-white hover:bg-[#0D5FB3] hover:border-[#0D5FB3] transition-all duration-300"
        >
          {request.submitButton}
        </button>
      </form>

      <p class="mt-6 text-center text-sm text-gray-600">
        <a
          href="/copa-oautos-2026/login"
          class="inline-flex items-center gap-1.5 font-semibold text-[#117CD9] hover:underline"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="w-3.5 h-3.5"
            aria-hidden="true"
          >
            <path d="m15 18-6-6 6-6" />
          </svg>
          {request.backToLogin}
        </a>
      </p>

      <p class="mt-8 text-center text-xs text-gray-400 leading-relaxed">
        {request.footnote}
      </p>
    </div>
  </section>
</CopaAppLayout>

<script
  is:inline
  define:vars={{
    errorEmpty: request.errorEmptyEmail,
    errorInvalid: request.errorInvalidEmail,
  }}
>
  (() => {
    const form = document.getElementById("copa-recovery-form");
    const emailInput = document.getElementById("copa-recovery-email");
    const errorEl = document.getElementById("copa-recovery-error");
    if (!form || !emailInput || !errorEl) return;

    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      errorEl.classList.add("hidden");
      errorEl.textContent = "";

      const email = emailInput.value.trim();

      if (!email) {
        errorEl.textContent = errorEmpty;
        errorEl.classList.remove("hidden");
        return;
      }
      if (!emailRegex.test(email)) {
        errorEl.textContent = errorInvalid;
        errorEl.classList.remove("hidden");
        return;
      }

      // TODO: reemplazar por la llamada real al endpoint de recuperación.
      const target = `/copa-oautos-2026/recuperar-password-enviado?email=${encodeURIComponent(email)}`;
      window.location.href = target;
    });
  })();
</script>
