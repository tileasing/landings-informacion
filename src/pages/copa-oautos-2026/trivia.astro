---
import CopaAppLayout from "../../layouts/CopaAppLayout.astro";
import AppNavbar from "../../components/copa-oautos-2026-app/AppNavbar.astro";
import TriviaHeader from "../../components/copa-oautos-2026-app/trivia/TriviaHeader.astro";
import TriviaCard from "../../components/copa-oautos-2026-app/trivia/TriviaCard.astro";
import TriviaPointsModal from "../../components/copa-oautos-2026-app/trivia/TriviaPointsModal.astro";
import TriviaGameModal from "../../components/copa-oautos-2026-app/trivia/TriviaGameModal.astro";
import { content } from "../../content/copa-oautos-2026-app";
import { API_BASE } from "../../lib/api";

const { trivia, navbar } = content;

// Cada trivia cierra cuando se abre la siguiente.
// La última trivia (cuestionario final) no tiene cierre automático.
const orderedTrivias = trivia.trivias
  .slice()
  .sort(
    (a, b) =>
      new Date(a.availableFrom).getTime() -
      new Date(b.availableFrom).getTime(),
  );

const triviasWithClose = orderedTrivias.map((t, i) => ({
  trivia: t,
  closesAt: orderedTrivias[i + 1]?.availableFrom ?? null,
}));

// Datos para el script (solo lo necesario para el wizard).
const triviasForScript = orderedTrivias.map((t) => ({
  id: t.id,
  name: t.name,
  title: t.title,
  typeLabel: t.typeLabel,
  availableFrom: t.availableFrom,
  questions: t.questions,
}));
---

<CopaAppLayout
  title={trivia.meta.title}
  description={trivia.meta.description}
  requireAuth
>
  <AppNavbar content={navbar} />
  <main class="bg-[#F4F7FB] min-h-[calc(100dvh-4rem)]">
    <TriviaHeader
      header={trivia.header}
      rules={trivia.rules}
      backLabel={trivia.labels.backToDashboard}
      backHref={navbar.homeHref}
    />

    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 py-6 sm:py-8 space-y-3 sm:space-y-4">
      {
        triviasWithClose.map(({ trivia: t, closesAt }, i) => (
          <TriviaCard
            trivia={t}
            closesAt={closesAt}
            labels={trivia.labels}
            maxPoints={trivia.pointsConfig.maxPerTrivia}
            index={i}
          />
        ))
      }
    </div>
  </main>

  <TriviaPointsModal content={trivia.pointsTable} />
  <TriviaGameModal labels={trivia.labels} />
</CopaAppLayout>

<script
  is:inline
  define:vars={{
    trivias: triviasForScript,
    apiBase: API_BASE,
    labels: trivia.labels,
  }}
>
  (() => {
    // === Helpers ===
    const dateFmt = new Intl.DateTimeFormat("es-MX", {
      timeZone: "America/Mexico_City",
      weekday: "long",
      day: "numeric",
      month: "long",
    });
    const dateTimeFmt = new Intl.DateTimeFormat("es-MX", {
      timeZone: "America/Mexico_City",
      weekday: "long",
      day: "numeric",
      month: "long",
      hour: "2-digit",
      minute: "2-digit",
      hour12: false,
    });
    const formatDate = (iso) => {
      try {
        return dateFmt.format(new Date(iso));
      } catch (_) {
        return iso;
      }
    };
    const formatDateTime = (iso) => {
      try {
        return dateTimeFmt.format(new Date(iso));
      } catch (_) {
        return iso;
      }
    };

    // === State de resultados (se rellena desde la API) ===
    let results = {};

    // === Render del estado de cada tarjeta ===
    const PLAY_BTN_ACTIVE = [
      "bg-[#5F8750]",
      "text-white",
      "hover:bg-[#3F5E33]",
      "shadow",
    ];
    const PLAY_BTN_PENDING = [
      "bg-gray-100",
      "text-gray-400",
      "cursor-not-allowed",
      "ring-1",
      "ring-gray-200",
    ];

    const stylePlayButton = (card, variant) => {
      const playBtn = card.querySelector("[data-trivia-play]");
      if (!playBtn) return;
      [...PLAY_BTN_ACTIVE, ...PLAY_BTN_PENDING].forEach((c) =>
        playBtn.classList.remove(c),
      );
      const textEl = playBtn.querySelector("[data-trivia-play-text]");
      const iconPlay = playBtn.querySelector("[data-trivia-play-icon-play]");
      const iconPending = playBtn.querySelector(
        "[data-trivia-play-icon-pending]",
      );

      if (variant === "active") {
        PLAY_BTN_ACTIVE.forEach((c) => playBtn.classList.add(c));
        if (textEl) textEl.textContent = playBtn.dataset.labelPlay;
        iconPlay?.classList.remove("hidden");
        iconPending?.classList.add("hidden");
        playBtn.disabled = false;
        playBtn.removeAttribute("title");
      } else {
        PLAY_BTN_PENDING.forEach((c) => playBtn.classList.add(c));
        if (textEl) textEl.textContent = playBtn.dataset.labelPending;
        iconPlay?.classList.add("hidden");
        iconPending?.classList.remove("hidden");
        playBtn.disabled = true;
        playBtn.setAttribute("title", labels.pendingHint);
      }
    };

    const setStatus = (card, status, hasContent) => {
      const badge = card.querySelector("[data-trivia-status]");
      if (!badge) return;
      badge.classList.remove(
        "bg-gray-200",
        "text-gray-700",
        "bg-emerald-100",
        "text-emerald-700",
        "bg-amber-100",
        "text-amber-800",
        "bg-red-100",
        "text-red-700",
      );
      const accent = card.querySelector(".copa-trivia-card-accent");
      if (accent) {
        accent.classList.remove(
          "bg-gray-200",
          "bg-[#5F8750]",
          "bg-emerald-500",
          "bg-red-300",
        );
      }
      const playBtn = card.querySelector("[data-trivia-play]");
      const resultBlock = card.querySelector("[data-trivia-result]");
      const map = {
        locked: {
          label: badge.dataset.labelLocked,
          badgeClasses: ["bg-gray-200", "text-gray-700"],
          accentClass: "bg-gray-200",
          playVariant: "pending", // Próximamente en gris.
          showResult: false,
        },
        available: {
          label: badge.dataset.labelAvailable,
          badgeClasses: ["bg-emerald-100", "text-emerald-700"],
          accentClass: "bg-[#5F8750]",
          playVariant: hasContent ? "active" : "pending",
          showResult: false,
        },
        closed: {
          label: badge.dataset.labelClosed,
          badgeClasses: ["bg-red-100", "text-red-700"],
          accentClass: "bg-red-300",
          playVariant: null,
          showResult: false,
        },
        completed: {
          label: badge.dataset.labelCompleted,
          badgeClasses: ["bg-emerald-100", "text-emerald-700"],
          accentClass: "bg-emerald-500",
          playVariant: null,
          showResult: true,
        },
      };
      const cfg = map[status];
      badge.textContent = cfg.label;
      cfg.badgeClasses.forEach((c) => badge.classList.add(c));
      if (accent) accent.classList.add(cfg.accentClass);

      if (playBtn) {
        if (cfg.playVariant) {
          playBtn.classList.remove("hidden");
          playBtn.style.display = "";
          stylePlayButton(card, cfg.playVariant);
        } else {
          playBtn.classList.add("hidden");
          // Refuerzo: inline-flex podría ganarle a .hidden por orden en el CSS,
          // así que también escondemos con estilo inline para asegurar.
          playBtn.style.display = "none";
        }
      }
      if (resultBlock) {
        if (cfg.showResult) {
          resultBlock.classList.remove("hidden");
          resultBlock.style.display = "";
        } else {
          resultBlock.classList.add("hidden");
          resultBlock.style.display = "none";
        }
      }
    };

    const refreshCard = (card) => {
      const triviaId = card.dataset.triviaId;
      const availableFrom = new Date(card.dataset.availableFrom);
      const closesAtRaw = card.dataset.closesAt;
      const closesAt = closesAtRaw ? new Date(closesAtRaw) : null;
      const hasContent = card.dataset.hasContent === "1";
      const now = new Date();

      const meta = card.querySelector("[data-trivia-meta]");
      const metaText = card.querySelector(".copa-trivia-meta-text");
      const resultPointsEl = card.querySelector("[data-trivia-result-points]");

      const stored = results[triviaId];
      let status;
      let metaContent = "";

      if (stored) {
        status = "completed";
        if (resultPointsEl) resultPointsEl.textContent = `+${stored.total}`;
        const completedDate = formatDate(stored.completedAt);
        metaContent = `${meta.dataset.prefixCompleted} ${completedDate}`;
      } else if (now < availableFrom) {
        status = "locked";
        metaContent = `${meta.dataset.prefixFrom} ${formatDate(availableFrom)}`;
      } else if (closesAt && now >= closesAt) {
        status = "closed";
        metaContent = meta.dataset.closedMessage;
      } else {
        status = "available";
        if (closesAt) {
          metaContent = `${meta.dataset.prefixCloses} ${formatDate(closesAt)}`;
        } else {
          metaContent = `${meta.dataset.prefixFrom} ${formatDate(availableFrom)}`;
        }
      }

      if (metaText) metaText.textContent = metaContent;
      setStatus(card, status, hasContent);
    };

    const triviaCards = Array.from(document.querySelectorAll("[data-trivia-card]"));
    triviaCards.forEach(refreshCard);
    // Refrescar cada minuto por si el cutoff o disponibilidad cambia.
    setInterval(() => triviaCards.forEach(refreshCard), 60 * 1000);

    // === Wizard del juego ===
    const modal = document.getElementById("copa-trivia-game-modal");
    const slidesContainer = modal?.querySelector("[data-trivia-slides]");
    const resultsView = modal?.querySelector("[data-trivia-results]");
    const progressBar = modal?.querySelector("[data-trivia-game-progress]");
    const progressPercent = modal?.querySelector(
      "[data-trivia-game-percent]",
    );
    const progressCounter = modal?.querySelector(
      "[data-trivia-game-counter]",
    );
    const progressWrap = modal?.querySelector(
      "[data-trivia-game-progress-bar]",
    );
    const footer = modal?.querySelector("[data-trivia-game-footer]");
    const prevBtn = modal?.querySelector("[data-trivia-game-prev]");
    const nextBtn = modal?.querySelector("[data-trivia-game-next]");
    const submitBtn = modal?.querySelector("[data-trivia-game-submit]");
    const finishBtn = modal?.querySelector("[data-trivia-game-finish]");
    const closeBtn = modal?.querySelector("[data-trivia-game-close]");
    const titleEl = modal?.querySelector("[data-trivia-game-title]");
    const eyebrowEl = modal?.querySelector("[data-trivia-game-eyebrow]");
    const resultsSummaryEl = modal?.querySelector(
      "[data-trivia-results-summary]",
    );
    const resultsPointsEl = modal?.querySelector(
      "[data-trivia-results-points]",
    );
    const resultsBreakdownEl = modal?.querySelector(
      "[data-trivia-results-breakdown]",
    );
    const resultsReviewEl = modal?.querySelector(
      "[data-trivia-results-review]",
    );

    let session = null; // { trivia, answers, currentIndex }
    let isSubmitting = false;

    // === Timer ===
    const TIMER_SECONDS = 10;
    let timerInterval = null;
    let timerSecondsLeft = TIMER_SECONDS;

    const timerWrap = modal?.querySelector("[data-trivia-timer-wrap]");
    const timerEl = modal?.querySelector("[data-trivia-timer]");
    const timeoutToast = modal?.querySelector("[data-trivia-timeout-toast]");

    const setTimerState = (seconds) => {
      if (!timerEl || !timerWrap) return;
      timerEl.textContent = String(seconds);
      timerWrap.classList.remove(
        "bg-[#5F8750]/10", "text-[#5F8750]",
        "bg-amber-100", "text-amber-600",
        "bg-red-100", "text-red-600",
      );
      if (seconds <= 3) {
        timerWrap.classList.add("bg-red-100", "text-red-600");
      } else if (seconds <= 5) {
        timerWrap.classList.add("bg-amber-100", "text-amber-600");
      } else {
        timerWrap.classList.add("bg-[#5F8750]/10", "text-[#5F8750]");
      }
      // Animación de parpadeo al cambiar de segundo
      timerEl.classList.remove("tick");
      timerWrap.classList.remove("tick-ring");
      void timerEl.offsetWidth; // forzar reflow para reiniciar la animación
      timerEl.classList.add("tick");
      timerWrap.classList.add("tick-ring");
    };

    const stopTimer = () => {
      if (timerInterval) {
        clearInterval(timerInterval);
        timerInterval = null;
      }
    };

    const renderSlide = () => {
      if (!session || !session.currentQuestion || !slidesContainer) return;
      const question = session.currentQuestion;
      const selected = session.currentAnswer;

      slidesContainer.innerHTML = "";
      const slide = document.createElement("div");
      slide.className = "trivia-slide";
      slide.innerHTML = `
        <h3 class="text-lg sm:text-xl font-bold text-[#0D2C4D] leading-snug mb-5">${question.text}</h3>
        <div class="space-y-2.5">
          ${question.options
            .map((opt) => {
              const isSelected = selected === opt.letter;
              return `
                <label class="trivia-option group flex items-center gap-3 p-3 sm:p-4 rounded-xl border-2 cursor-pointer transition ${isSelected ? "border-[#5F8750] bg-[#5F8750]/5" : "border-gray-200 hover:border-[#5F8750]/50 hover:bg-[#5F8750]/5"}">
                  <input type="radio" name="${question.id}" value="${opt.letter}" class="peer sr-only" ${isSelected ? "checked" : ""} />
                  <span class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-lg border-2 font-bold text-sm ${isSelected ? "bg-[#5F8750] border-[#5F8750] text-white" : "border-gray-300 text-gray-500 group-hover:border-[#5F8750] group-hover:text-[#5F8750]"}">${opt.letter}</span>
                  <span class="text-sm sm:text-base text-gray-800">${opt.text}</span>
                </label>
              `;
            })
            .join("")}
        </div>
      `;
      slidesContainer.appendChild(slide);

      // Wire up option selection
      slide.querySelectorAll("input[type=radio]").forEach((input) => {
        input.addEventListener("change", () => {
          session.currentAnswer = input.value;
          renderSlide();
          refreshFooter();
        });
      });
    };

    const refreshFooter = () => {
      if (!session) return;
      const { currentStatus, currentAnswer } = session;
      const current = currentStatus?.current ?? 1;
      const total = currentStatus?.total ?? 1;
      const isLast = current === total;
      const hasAnswer = !!currentAnswer;

      // No se puede retroceder con el flujo de preguntas por API
      if (prevBtn) prevBtn.classList.add("hidden");
      if (nextBtn) {
        nextBtn.classList.toggle("hidden", isLast);
        nextBtn.disabled = !hasAnswer;
      }
      if (submitBtn) {
        submitBtn.classList.toggle("hidden", !isLast);
        submitBtn.disabled = !hasAnswer;
      }

      if (progressCounter)
        progressCounter.textContent = `${labels.questionLabel} ${current} de ${total}`;
      const pct = Math.round((current / total) * 100);
      if (progressPercent) progressPercent.textContent = `${pct}%`;
      if (progressBar) progressBar.style.width = `${pct}%`;
    };

    // Bloquea el scroll del body manteniendo la posición actual.
    // handleTimerExpiry y startTimer se definen aquí porque necesitan renderSlide/refreshFooter.
    const handleTimerExpiry = () => {
      if (!session) return;
      stopTimer();
      // El backend responde automáticamente — solo mostrar toast y avanzar
      if (timeoutToast) timeoutToast.classList.remove("hidden");
      setTimeout(async () => {
        if (!session) return;
        if (timeoutToast) timeoutToast.classList.add("hidden");
        await advanceToNext();
      }, 1800);
    };

    const startTimer = (secondsAllowed, startedAt) => {
      stopTimer();
      // Si el backend manda null no se muestra el contador
      if (secondsAllowed === null || secondsAllowed === undefined) {
        if (timerWrap) {
          timerWrap.classList.add("hidden");
          timerWrap.classList.remove("flex");
        }
        return;
      }
      // Calcular tiempo restante descontando lo que ya transcurrió desde startedAt
      let remaining = secondsAllowed;
      if (startedAt) {
        const elapsed = Math.floor((Date.now() - new Date(startedAt).getTime()) / 1000);
        remaining = Math.max(0, remaining - elapsed);
      }
      timerSecondsLeft = remaining;
      if (timerWrap) {
        timerWrap.classList.remove("hidden");
        timerWrap.classList.add("flex");
      }
      if (timeoutToast) timeoutToast.classList.add("hidden");
      setTimerState(timerSecondsLeft);
      if (timerSecondsLeft <= 0) {
        handleTimerExpiry();
        return;
      }
      timerInterval = setInterval(() => {
        timerSecondsLeft -= 1;
        setTimerState(timerSecondsLeft);
        if (timerSecondsLeft <= 0) {
          handleTimerExpiry();
        }
      }, 1000);
    };

    let savedScrollY = 0;
    const lockBodyScroll = () => {
      savedScrollY = window.scrollY;
      document.body.style.position = "fixed";
      document.body.style.top = `-${savedScrollY}px`;
      document.body.style.left = "0";
      document.body.style.right = "0";
      document.body.style.width = "100%";
    };
    const unlockBodyScroll = () => {
      document.body.style.position = "";
      document.body.style.top = "";
      document.body.style.left = "";
      document.body.style.right = "";
      document.body.style.width = "";
      window.scrollTo(0, savedScrollY);
    };

    // === Funciones del flujo API por pregunta ===

    // Carga la pregunta actual desde GET /api/trivia/{id}/play y actualiza el modal.
    const playQuestion = async (triviaId) => {
      if (!session) return;
      const token = localStorage.getItem("copa_auth_token");
      try {
        const res = await fetch(`${apiBase}/api/trivia/${triviaId}/play`, {
          headers: token ? { "Authorization": "Bearer " + token } : {},
        });
        if (!res.ok) {
          // Si el servidor responde con error, la trivia probablemente terminó
          await fetchResultsAndShow(triviaId);
          return;
        }
        const json = await res.json();
        if (!json.success || !json.data) {
          await fetchResultsAndShow(triviaId);
          return;
        }
        const { question, status } = json.data;
        session.currentQuestion = question;
        session.currentAnswer = null;
        session.currentStatus = status;

        renderSlide();
        refreshFooter();
        startTimer(status.secondsAllowed, status.startedAt);
      } catch (err) {
        if (session) alert("Error al cargar la pregunta. Por favor intenta de nuevo.");
      }
    };

    // Avanza a la siguiente pregunta verificando antes si la trivia ya terminó.
    const advanceToNext = async () => {
      if (!session) return;
      const triviaId = session.triviaId;
      const token = localStorage.getItem("copa_auth_token");
      try {
        const statusRes = await fetch(`${apiBase}/api/trivia/${triviaId}/status`, {
          headers: token ? { "Authorization": "Bearer " + token } : {},
        });
        if (statusRes.ok) {
          const statusJson = await statusRes.json();
          if (statusJson.success && statusJson.data?.isCompleted) {
            await fetchResultsAndShow(triviaId);
            return;
          }
        }
      } catch (_) {}
      await playQuestion(triviaId);
    };

    // Obtiene los resultados finales desde GET /api/trivia/{id}/response y los muestra.
    const fetchResultsAndShow = async (triviaId) => {
      if (!session) return;
      const token = localStorage.getItem("copa_auth_token");
      let submitData = { correctAnswers: 0, totalQuestions: 0, pointsEarned: 0, breakdown: {} };
      let reviewData = null;
      try {
        const res = await fetch(`${apiBase}/api/trivia/${triviaId}/response`, {
          headers: token ? { "Authorization": "Bearer " + token } : {},
        });
        if (res.ok) {
          const json = await res.json();
          if (json.success && json.data) {
            reviewData = json.data;
            submitData = {
              correctAnswers: json.data.correctAnswers ?? json.data.totalCorrect ?? 0,
              totalQuestions: json.data.totalQuestions ?? 0,
              pointsEarned: json.data.pointsEarned ?? json.data.totalPoints ?? 0,
              breakdown: json.data.breakdown ?? {},
              completedAt: json.data.completedAt,
            };
          }
        }
      } catch (_) {}

      // Actualizar tarjeta
      results[triviaId] = {
        total: submitData.pointsEarned,
        completedAt: submitData.completedAt ?? new Date().toISOString(),
      };
      const card = document.querySelector(`[data-trivia-card][data-trivia-id="${triviaId}"]`);
      if (card) refreshCard(card);

      showResults(submitData, reviewData);
    };

    // Envía la respuesta del usuario via POST /api/trivia/{id}/answer.
    const submitCurrentAnswer = async () => {
      if (!session || !session.currentAnswer || isSubmitting) return;
      stopTimer();
      isSubmitting = true;
      const triviaId = session.triviaId;
      const token = localStorage.getItem("copa_auth_token");
      const answer = session.currentAnswer;

      if (nextBtn) nextBtn.disabled = true;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = "Enviando...";
      }

      try {
        const res = await fetch(`${apiBase}/api/trivia/${triviaId}/answer`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            ...(token ? { "Authorization": "Bearer " + token } : {}),
          },
          body: JSON.stringify({ answer }),
        });
        const json = await res.json();
        if (!res.ok || !json.success) {
          throw new Error((json && json.message) || "Error al enviar la respuesta");
        }
        isSubmitting = false;
        if (json.data.next) {
          await playQuestion(triviaId);
        } else {
          await fetchResultsAndShow(triviaId);
        }
      } catch (err) {
        isSubmitting = false;
        if (nextBtn) nextBtn.disabled = false;
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = labels.submitButton;
        }
        alert("Hubo un error al enviar tu respuesta. Por favor intenta de nuevo.");
      }
    };

    const openGame = async (triviaId) => {
      const trivia = trivias.find((t) => t.id === triviaId);
      if (!trivia || !modal || !slidesContainer) return;
      if (results[triviaId]) return; // Ya completada, no se vuelve a jugar.

      // Consultar el estado actual de la trivia antes de abrir
      const token = localStorage.getItem("copa_auth_token");
      try {
        const statusRes = await fetch(`${apiBase}/api/trivia/${triviaId}/status`, {
          headers: token ? { "Authorization": "Bearer " + token } : {},
        });
        if (statusRes.ok) {
          const statusJson = await statusRes.json();
          if (statusJson.success && statusJson.data) {
            const { isCompleted, status } = statusJson.data;
            if (isCompleted || status === "completed") {
              const card = document.querySelector(
                `[data-trivia-card][data-trivia-id="${triviaId}"]`,
              );
              if (card) refreshCard(card);
              return;
            }
          }
        }
      } catch (_) { /* continuar si falla el status */ }

      session = {
        triviaId,
        currentQuestion: null,
        currentAnswer: null,
        currentStatus: null,
      };

      if (titleEl) titleEl.textContent = trivia.title;
      if (eyebrowEl) eyebrowEl.textContent = `${trivia.name} · ${trivia.typeLabel}`;

      // Reset UI
      resultsView?.classList.add("hidden");
      slidesContainer.classList.remove("hidden");
      progressWrap?.classList.remove("hidden");
      prevBtn?.classList.add("hidden"); // No se puede retroceder con el flujo API
      nextBtn?.classList.remove("hidden");
      submitBtn?.classList.add("hidden");
      finishBtn?.classList.add("hidden");

      lockBodyScroll();
      if (typeof modal.showModal === "function") {
        modal.showModal();
      } else {
        modal.setAttribute("open", "");
      }

      // Cargar la primera (o actual) pregunta desde la API
      await playQuestion(triviaId);
    };

    const closeGame = () => {
      if (!modal) return;
      stopTimer();
      isSubmitting = false;
      if (timerWrap) {
        timerWrap.classList.remove("flex");
        timerWrap.classList.add("hidden");
      }
      if (timeoutToast) timeoutToast.classList.add("hidden");
      modal.close();
      unlockBodyScroll();
      session = null;
    };

    // Cuando se cierra con tecla Esc el native dialog tambien dispara "close".
    modal?.addEventListener("close", () => unlockBodyScroll());

    const showResults = (submitData, reviewData) => {
      if (!session || !modal || !resultsView) return;

      stopTimer();
      if (timerWrap) {
        timerWrap.classList.remove("flex");
        timerWrap.classList.add("hidden");
      }
      slidesContainer?.classList.add("hidden");
      progressWrap?.classList.add("hidden");
      prevBtn?.classList.add("hidden");
      nextBtn?.classList.add("hidden");
      submitBtn?.classList.add("hidden");
      finishBtn?.classList.remove("hidden");
      resultsView.classList.remove("hidden");

      const totalCorrect = submitData.correctAnswers ?? 0;
      const totalQuestions = submitData.totalQuestions ?? 0;
      const pointsEarned = submitData.pointsEarned ?? 0;
      const breakdown = submitData.breakdown ?? {};

      if (resultsPointsEl) resultsPointsEl.textContent = `+${pointsEarned}`;
      if (resultsSummaryEl) {
        resultsSummaryEl.textContent = `Acertaste ${totalCorrect} de ${totalQuestions} preguntas.`;
      }

      // Desglose
      if (resultsBreakdownEl) {
        const rows = [];
        if (breakdown.completion) {
          rows.push(
            `<li class="flex items-center justify-between gap-3 text-gray-700"><span>${labels.breakdownCompletion}</span><span class="font-bold text-[#0D2C4D]">+${breakdown.completion}</span></li>`,
          );
        }
        if (breakdown.correctAnswers) {
          rows.push(
            `<li class="flex items-center justify-between gap-3 text-gray-700"><span>${labels.breakdownPerCorrect} (${totalCorrect} correctas)</span><span class="font-bold text-[#0D2C4D]">+${breakdown.correctAnswers}</span></li>`,
          );
        }
        if (breakdown.allCorrectBonus > 0) {
          rows.push(
            `<li class="flex items-center justify-between gap-3 text-gray-700"><span>${labels.breakdownAllCorrect}</span><span class="font-bold text-[#0D2C4D]">+${breakdown.allCorrectBonus}</span></li>`,
          );
        }
        if (breakdown.oautosMultiplier) {
          rows.push(
            `<li class="flex items-center justify-between gap-3 text-emerald-700 border-t border-emerald-100 pt-1.5 mt-1"><span class="font-semibold">${labels.breakdownOautos}</span><span class="font-bold">×2</span></li>`,
          );
        }
        resultsBreakdownEl.innerHTML = rows.join("");
      }

      // Review: usar datos detallados de la API si están disponibles
      if (resultsReviewEl) {
        if (reviewData && reviewData.questions) {
          resultsReviewEl.innerHTML = reviewData.questions
            .map((q, idx) => {
              const userOption = q.options.find((o) => o.letter === q.userAnswer);
              const correctOption = q.options.find((o) => o.letter === q.correctAnswer);
              return `
                <div class="bg-white rounded-xl ring-1 ring-gray-200 p-4">
                  <p class="text-xs text-gray-500 mb-1">Pregunta ${idx + 1}</p>
                  <p class="text-sm font-semibold text-[#0D2C4D] mb-3">${q.text}</p>
                  <div class="space-y-1.5 text-xs sm:text-sm">
                    <div class="flex items-start gap-2 ${q.isCorrect ? "text-emerald-700" : "text-red-700"}">
                      <span class="font-bold flex-shrink-0">${q.isCorrect ? "✓" : "✗"} ${labels.yourAnswerLabel}:</span>
                      <span>${userOption ? `${userOption.letter}) ${userOption.text}` : "—"}</span>
                    </div>
                    ${
                      !q.isCorrect && correctOption
                        ? `<div class="flex items-start gap-2 text-emerald-700"><span class="font-bold flex-shrink-0">★ ${labels.correctAnswerLabel}:</span><span>${correctOption.letter}) ${correctOption.text}</span></div>`
                        : ""
                    }
                  </div>
                </div>
              `;
            })
            .join("");
        } else {
          // Fallback: mostrar respuestas del usuario sin corrección
          const { trivia } = session;
          resultsReviewEl.innerHTML = trivia.questions
            .map((q, idx) => {
              const userAnswer = session.answers[q.id];
              const userOption = q.options.find((o) => o.letter === userAnswer);
              return `
                <div class="bg-white rounded-xl ring-1 ring-gray-200 p-4">
                  <p class="text-xs text-gray-500 mb-1">Pregunta ${idx + 1}</p>
                  <p class="text-sm font-semibold text-[#0D2C4D] mb-3">${q.text}</p>
                  <div class="space-y-1.5 text-xs sm:text-sm">
                    <div class="flex items-start gap-2 text-gray-700">
                      <span class="font-bold flex-shrink-0">→ ${labels.yourAnswerLabel}:</span>
                      <span>${userOption ? `${userOption.letter}) ${userOption.text}` : "—"}</span>
                    </div>
                  </div>
                </div>
              `;
            })
            .join("");
        }
      }
    };

    // Wire-up wizard buttons
    nextBtn?.addEventListener("click", () => submitCurrentAnswer());
    // prevBtn no se usa en el flujo API secuencial
    submitBtn?.addEventListener("click", () => submitCurrentAnswer());
    finishBtn?.addEventListener("click", () => closeGame());
    closeBtn?.addEventListener("click", () => closeGame());

    // Wire-up triggers desde las tarjetas
    triviaCards.forEach((card) => {
      const playBtn = card.querySelector("[data-trivia-play]");
      playBtn?.addEventListener("click", () => {
        const id = card.dataset.triviaId;
        if (id) openGame(id);
      });
    });

    // Backdrop click cierra
    modal?.addEventListener("click", (event) => {
      if (event.target === modal) closeGame();
    });

    // === Verificar estado inicial de cada trivia desde la API ===
    const initTriviaStatuses = async () => {
      const token = localStorage.getItem("copa_auth_token");
      if (!token) return;
      try {
        const res = await fetch(`${apiBase}/api/trivia/my-responses`, {
          headers: { "Authorization": "Bearer " + token },
        });
        if (res.ok) {
          const json = await res.json();
          if (json.success && json.data?.trivias) {
            json.data.trivias.forEach((t) => {
              results[t.triviaId] = {
                total: t.pointsEarned,
                completedAt: t.completedAt,
              };
            });
          }
        }
      } catch (_) { /* ignorar error */ }
      triviaCards.forEach(refreshCard);
    };
    initTriviaStatuses();
  })();
</script>
