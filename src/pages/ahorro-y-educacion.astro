---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/shared/Hero.astro';
import Habit from '../components/landings/ahorro-y-educacion/Habit.astro';
import CtaBanner from '../components/shared/CtaBanner.astro';
import Faq from '../components/shared/Faq.astro';
import ClosingCta from '../components/shared/ClosingCta.astro';
import Footer from '../components/shared/Footer.astro';
import { content } from '../content/ahorro-y-educacion';
---

<Layout title={content.meta.title} description={content.meta.description}>
	<Hero {...content.hero} />
	<Habit {...content.habit} />
	<CtaBanner {...content.banner} />
	<Faq {...content.faq} />
	{content.closingCta && <ClosingCta {...content.closingCta} />}
	<Footer {...content.footer} />
</Layout>
