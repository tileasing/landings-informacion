---
// Plans Component
const plans = [
  { name: 'Pagaré Light', rate: '8%', term: 'De 1 a 6 meses', min: '$200,000', popular: false },
  { name: 'Pagaré Básico', rate: '8,5%', term: 'De 7 a 12 meses', min: '$200,000', popular: false },
  { name: 'Pagaré Premium', rate: '9%', term: 'De 13 a 18 meses', min: '$200,000', popular: true },
  { name: 'Pagaré Total', rate: '9,5%', term: 'De 19 a 24 meses', min: '$200,000', popular: false },
];
---

<section id="plans" class="bg-[#EDF3FA] py-20">
  <div class="max-w-[1200px] mx-auto px-5">

    <!-- Encabezado -->
    <div class="text-center mb-12">
      <h2 class="text-3xl lg:text-4xl font-bold mb-4">
        Opciones de <span class="text-primary underline decoration-primary underline-offset-4">Inversión</span>
      </h2>
      <p class="text-gray-500 text-lg">Elige el plazo que mejor se adapte a tus objetivos financieros</p>
    </div>

    <!-- Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {plans.map((plan) => (
        <div class={`relative bg-white rounded-2xl p-8 flex flex-col items-center text-center transition-all duration-300 hover:shadow-md ${plan.popular ? 'border-2 border-primary shadow-lg hover:shadow-xl' : 'border border-transparent shadow-sm hover:border-primary/40'}`}>

          {plan.popular && (
            <span class="absolute -top-4 bg-[#F5A623] text-white text-sm font-semibold px-4 py-1 rounded-full">
              Más popular
            </span>
          )}

          <h3 class="text-xl font-bold mb-3">{plan.name}</h3>
          <p class="text-5xl font-bold font-heading text-secondary mb-2">{plan.rate}</p>
          <p class="text-sm text-gray-400 mb-6">Rendimiento total a 12 meses</p>

          <!-- Detalles -->
          <div class="w-full space-y-4 mb-8">
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 rounded-full bg-[#EDF3FA] flex items-center justify-center shrink-0">
                <svg class="w-4 h-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div class="text-left">
                <p class="text-xs text-gray-400">Plazo</p>
                <p class="text-sm font-semibold text-gray-700">{plan.term}</p>
              </div>
            </div>

            <div class="flex items-center gap-3">
              <div class="w-9 h-9 rounded-full bg-[#EDF3FA] flex items-center justify-center shrink-0">
                <svg class="w-4 h-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1" />
                </svg>
              </div>
              <div class="text-left">
                <p class="text-xs text-gray-400">Inversión mínima</p>
                <p class="text-sm font-semibold text-gray-700">{plan.min}</p>
              </div>
            </div>
          </div>

          <a href="https://inversiones.oautos.mx/login" class="w-full inline-block bg-[#117CD9] text-white text-center font-medium py-3 rounded-xl hover:bg-[#0D5FB3] transition-colors">
            Elegir plan
          </a>

        </div>
      ))}
    </div>

  </div>
</section>
