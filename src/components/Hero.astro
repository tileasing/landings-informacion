---
// Hero Component
import Button from "./Button.astro";
---

<section id="hero" class="bg-[#EDF3FA] py-12 lg:py-20">
  <div class="max-w-[1200px] mx-auto px-5 text-center">
    <!-- Badge -->
    <span
      class="inline-block bg-[#C9E5F8] text-primary font-semibold text-xs lg:text-sm px-5 lg:px-6 py-2 rounded-full mb-6"
    >
      Plataforma segura y respaldada
    </span>

    <!-- Título -->
    <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-6">
      Invierte en el <span class="text-primary">Sector Automotriz</span>
    </h1>

    <!-- Descripción -->
    <p
      class="text-base lg:text-lg text-gray-500 max-w-3xl mx-auto mb-10 leading-relaxed"
    >
      Genera intereses superiores al cete invirtiendo en pagarés digitales
      respaldados por activos automotrices. Seguro, transparente y 100% legal
    </p>

    <!-- Botones -->
    <div class="flex flex-col sm:flex-row justify-center gap-4 mb-16">
      <Button
        variant="principal"
        text="Comenzar a invertir"
        href="https://inversiones.oautos.mx/login"
      />
      <Button variant="secondary" text="Conocer más" href="#about" />
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-6">
      <div
        class="bg-white rounded-xl shadow-sm py-8 px-6 text-center border border-transparent transition-all duration-300 hover:border-primary/40 hover:shadow-md cursor-default"
      >
        <p
          class="text-2xl lg:text-4xl font-bold font-heading text-secondary mb-2"
        >
          $120M +
        </p>
        <p class="text-base font-medium text-gray-700">Invertidos</p>
      </div>
      <div
        class="bg-white rounded-xl shadow-sm py-8 px-6 text-center border border-transparent transition-all duration-300 hover:border-primary/40 hover:shadow-md cursor-default"
      >
        <p
          class="text-2xl lg:text-4xl font-bold font-heading text-secondary mb-2"
        >
          100 +
        </p>
        <p class="text-base font-medium text-gray-700">Inversionistas</p>
      </div>
      <div
        class="bg-white rounded-xl shadow-sm py-8 px-6 text-center border border-transparent transition-all duration-300 hover:border-primary/40 hover:shadow-md cursor-default"
      >
        <p
          class="text-2xl lg:text-4xl font-bold font-heading text-secondary mb-2"
        >
          98%
        </p>
        <p class="text-base font-medium text-gray-700">Satisfacción</p>
      </div>
      <div
        class="bg-white rounded-xl shadow-sm py-8 px-6 text-center border border-transparent transition-all duration-300 hover:border-primary/40 hover:shadow-md cursor-default"
      >
        <p
          class="text-2xl lg:text-4xl font-bold font-heading text-secondary mb-2"
        >
          5 años
        </p>
        <p class="text-base font-medium text-gray-700">Experiencia</p>
      </div>
    </div>
  </div>
</section>
