---
// Benefits Component
const benefits = [
  {
    title: 'Inversión Segura',
    description: 'Respaldada por activos automotrices con seguro y protección legal',
    icon: `<svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
    </svg>`,
  },
  {
    title: 'Rendimientos Competitivos',
    description: 'Tasas superiores al promedio del mercado financiero tradicional',
    icon: `<svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" />
    </svg>`,
  },
  {
    title: '100% Digital',
    description: 'Nuestro proceso es seguro, sencillo y cumple con todos los parametros de seguridad.',
    icon: `<svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" />
    </svg>`,
  },
  {
    title: 'Documentación Legal',
    description: 'Pagaré digital con todos los requerimientos de la ley incluyendo la NOM 151.',
    icon: `<svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
    </svg>`,
  },
];
---

<section id="benefits" class="bg-white py-20">
  <div class="max-w-[1200px] mx-auto px-5">
    <div class="flex flex-col lg:flex-row gap-10 lg:gap-16 items-start">

      <!-- Título izquierda -->
      <div class="w-full lg:w-2/5 lg:sticky top-10">
        <h2 class="text-3xl lg:text-4xl font-bold mb-4">
          ¿Por qué <span class="text-primary">Oautos Inversiones?</span>
        </h2>
        <p class="text-gray-500 text-lg">Tu inversión está protegida y respaldada</p>
      </div>

      <!-- Cards derecha -->
      <div class="w-full lg:w-3/5 space-y-5">
        {benefits.map((benefit) => (
          <div class="border border-gray-200 rounded-2xl p-8 transition-all duration-300 hover:translate-x-2 hover:border-l-4 hover:border-l-primary hover:shadow-md cursor-default">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-10 h-10 rounded-lg bg-[#E0F0FF] flex items-center justify-center shrink-0">
                <Fragment set:html={benefit.icon} />
              </div>
              <h3 class="text-lg font-bold">{benefit.title}</h3>
            </div>
            <p class="text-gray-500 leading-relaxed">{benefit.description}</p>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>
