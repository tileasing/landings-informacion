---
import type {
  CopaTriviaContent,
  CopaTriviaItem,
} from "../../../content/copa-oautos-2026-app";

interface Props {
  trivia: CopaTriviaItem;
  closesAt: string | null; // ISO de la siguiente trivia (o null si es la última)
  labels: CopaTriviaContent["labels"];
  maxPoints: number;
  index: number;
}

const { trivia, closesAt, labels, maxPoints, index } = Astro.props;
const hasContent = trivia.questions.length > 0;
const isFinal = !closesAt;
---

<article
  class="copa-trivia-card group bg-white rounded-2xl shadow-sm ring-1 ring-gray-100 overflow-hidden transition hover:shadow-md"
  data-trivia-card
  data-trivia-id={trivia.id}
  data-trivia-name={trivia.name}
  data-trivia-title={trivia.title}
  data-available-from={trivia.availableFrom}
  data-closes-at={closesAt ?? ""}
  data-has-content={hasContent ? "1" : "0"}
  data-trivia-index={index}
>
  <div class="flex items-stretch">
    <!-- Franja lateral con índice -->
    <div
      class="copa-trivia-card-accent flex-shrink-0 w-2 sm:w-3 bg-gray-200 transition"
      aria-hidden="true"
    >
    </div>

    <div class="flex-1 min-w-0 p-4 sm:p-5">
      <div class="flex items-start justify-between gap-3 mb-2">
        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-center gap-2 mb-1">
            <span
              class="text-[10px] sm:text-xs font-bold uppercase tracking-wider text-gray-400"
            >
              {trivia.name}
            </span>
            <span
              class:list={[
                "text-[10px] font-semibold uppercase tracking-wider rounded-full px-2 py-0.5",
                trivia.typeLabel.toLowerCase().includes("méxico")
                  ? "bg-[#5F8750]/15 text-[#3F5E33]"
                  : trivia.typeLabel.toLowerCase().includes("experiencia")
                    ? "bg-amber-100 text-amber-700"
                    : "bg-[#117CD9]/10 text-[#0D5FB3]",
              ]}
            >
              {trivia.typeLabel}
            </span>
          </div>
          <h3
            class="text-base sm:text-lg font-extrabold text-[#0D2C4D] leading-tight"
          >
            {trivia.title}
          </h3>
        </div>
        <span
          class="copa-trivia-status flex-shrink-0 text-[10px] sm:text-xs font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-gray-200 text-gray-700 whitespace-nowrap"
          data-trivia-status
          data-label-locked={labels.statusLocked}
          data-label-available={labels.statusAvailable}
          data-label-closed={labels.statusClosed}
          data-label-completed={labels.statusCompleted}
        >
          {labels.statusLocked}
        </span>
      </div>

      <p
        class="copa-trivia-meta text-xs sm:text-sm text-gray-600 mb-3 flex flex-wrap items-center gap-x-2 gap-y-1"
        data-trivia-meta
        data-prefix-from={labels.availableFromPrefix}
        data-prefix-closes={labels.closesPrefix}
        data-prefix-completed={labels.completedAtPrefix}
        data-closed-message={labels.closedMessage}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="w-3.5 h-3.5 flex-shrink-0"
          aria-hidden="true"
        >
          <rect width="18" height="18" x="3" y="4" rx="2" />
          <path d="M16 2v4" />
          <path d="M8 2v4" />
          <path d="M3 10h18" />
        </svg>
        <span class="copa-trivia-meta-text">—</span>
      </p>

      <div
        class="flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-gray-100"
      >
        <span
          class="text-[11px] sm:text-xs font-semibold text-amber-700 bg-amber-100 rounded-full px-2.5 py-1"
        >
          🏆 {labels.maxPointsLabel}
        </span>

        <button
          type="button"
          data-trivia-play
          data-label-play={labels.playButton}
          data-label-pending={labels.pendingContent}
          class="copa-trivia-action hidden inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-semibold transition shadow"
        >
          <span data-trivia-play-icon-pending class="hidden" aria-hidden="true">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-4 h-4"
            >
              <rect width="18" height="11" x="3" y="11" rx="2" ry="2" />
              <path d="M7 11V7a5 5 0 0 1 10 0v4" />
            </svg>
          </span>
          <span data-trivia-play-text>{labels.playButton}</span>
          <span data-trivia-play-icon-play aria-hidden="true">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-4 h-4"
            >
              <path d="M5 12h14" />
              <path d="m12 5 7 7-7 7" />
            </svg>
          </span>
        </button>

        <div
          class="copa-trivia-result hidden flex-1 sm:flex-initial flex items-center gap-2 text-sm font-bold text-emerald-700"
          data-trivia-result
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="w-4 h-4"
            aria-hidden="true"
          >
            <path d="M20 6 9 17l-5-5" />
          </svg>
          <span data-trivia-result-points>0</span>
          <span class="font-medium text-gray-600">
            {labels.pointsEarnedSuffix}
          </span>
        </div>
      </div>
    </div>
  </div>
</article>
