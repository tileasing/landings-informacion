---
import type {
  CopaAppDashboardContent,
  CopaAppUserPreview,
} from "../../content/copa-oautos-2026-app";

interface Props {
  content: CopaAppDashboardContent;
  user: CopaAppUserPreview;
}

const { content, user } = Astro.props;

const firstName = user.name.split(/\s+/)[0] || user.name;
---

<section
  class="relative overflow-hidden bg-gradient-to-br from-[#0D2C4D] via-[#117CD9] to-[#0D2C4D] text-white"
>
  <div class="absolute inset-0 bg-black/30" aria-hidden="true"></div>

  <div
    class="relative z-10 max-w-[1200px] mx-auto px-4 sm:px-6 py-10 sm:py-14"
  >
    <div class="max-w-2xl">
      <div class="flex flex-wrap items-center gap-2 sm:gap-3 mb-2">
        <span
          class="text-xs sm:text-sm font-semibold uppercase tracking-[0.2em] text-white/70"
          id="copa-dashboard-greeting"
        >
          {content.greetingMorning}
        </span>
        <span
          aria-label={content.liveClockLabel}
          class="inline-flex items-center gap-1.5 bg-white/10 backdrop-blur-sm border border-white/15 rounded-full pl-2 pr-3 py-1 text-[11px] sm:text-xs text-white/85"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="w-3 h-3 text-white/70"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10" />
            <polyline points="12 6 12 12 16 14" />
          </svg>
          <span id="copa-dashboard-date">—</span>
          <span class="text-white/40" aria-hidden="true">·</span>
          <span id="copa-dashboard-time" class="font-semibold tabular-nums">
            --:--
          </span>
        </span>
      </div>

      <h1
        class="text-3xl sm:text-4xl md:text-5xl font-extrabold leading-tight drop-shadow-sm"
      >
        ¡Hola, <span class="text-white" data-user-firstname>{firstName}</span>!
      </h1>
      <p class="mt-4 text-base sm:text-lg text-white/85 leading-relaxed">
        {content.welcomeIntro}
      </p>
    </div>
  </div>
</section>

<script
  is:inline
  define:vars={{
    morning: content.greetingMorning,
    afternoon: content.greetingAfternoon,
    evening: content.greetingEvening,
  }}
>
  (() => {
    const dateEl = document.getElementById("copa-dashboard-date");
    const timeEl = document.getElementById("copa-dashboard-time");
    const greetingEl = document.getElementById("copa-dashboard-greeting");
    if (!dateEl || !timeEl || !greetingEl) return;

    const dateFmt = new Intl.DateTimeFormat("es-MX", {
      weekday: "long",
      day: "numeric",
      month: "long",
    });
    const timeFmt = new Intl.DateTimeFormat("es-MX", {
      hour: "2-digit",
      minute: "2-digit",
      hour12: false,
    });

    const greet = (hour) => {
      if (hour < 12) return morning;
      if (hour < 19) return afternoon;
      return evening;
    };

    const render = () => {
      const now = new Date();
      dateEl.textContent = dateFmt.format(now);
      timeEl.textContent = timeFmt.format(now);
      greetingEl.textContent = greet(now.getHours());
    };

    render();
    // Solo necesitamos refrescar el minuto, ya no mostramos segundos.
    setInterval(render, 30 * 1000);
  })();
</script>
