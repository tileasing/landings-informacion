---
import Button from "../shared/Button.astro";
import logoOautos from "../../assets/logoOautos-copa.png";
import loginBg from "../../assets/backgroundImageHero.jpg";
import type { CopaAppLoginContent } from "../../content/copa-oautos-2026-app";
import { AUTH_ENDPOINTS } from "../../lib/api";

interface Props {
  content: CopaAppLoginContent;
}

const { content } = Astro.props;
---

<section
  class="relative min-h-dvh w-full flex items-center justify-center overflow-hidden px-5 py-12"
>
  <!-- Fondo: imagen del hero de la landing + gradiente de marca con opacidad encima -->
  <img
    src={loginBg.src}
    alt=""
    aria-hidden="true"
    class="absolute inset-0 w-full h-full object-cover"
  />
  <div
    class="absolute inset-0 bg-gradient-to-br from-[#0D2C4D]/70 via-[#117CD9]/60 to-[#0D2C4D]/50"
    aria-hidden="true"
  >
  </div>
  <div class="absolute inset-0 bg-black/30" aria-hidden="true"></div>

  <!-- Spinner overlay para magic token -->
  <div
    id="copa-token-spinner"
    class="hidden absolute inset-0 z-20 flex flex-col items-center justify-center bg-[#0D2C4D]/75 backdrop-blur-sm"
    aria-live="polite"
    aria-label="Verificando acceso"
  >
    <svg
      class="animate-spin h-14 w-14 text-white mb-5"
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
    </svg>
    <p class="text-white text-base font-semibold tracking-wide">Verificando acceso…</p>
  </div>

  <!-- Card del login -->
  <div
    class="relative z-10 w-full max-w-lg bg-white text-gray-900 rounded-3xl shadow-2xl px-7 sm:px-10 py-10"
  >
    <div class="text-center mb-8">
      <div class="inline-flex items-center justify-center px-5 py-3 mb-6">
        <img src={logoOautos.src} alt="Oautos" class="h-9 w-auto" />
      </div>

      <span
        class="block text-xs font-semibold uppercase tracking-[0.2em] text-[#117CD9] mb-2"
      >
        {content.eyebrow}
      </span>

      <h1 class="text-2xl sm:text-3xl font-extrabold leading-tight mb-5">
        {content.title}
      </h1>

      <p class="text-sm sm:text-base text-gray-600 leading-relaxed whitespace-pre-line">
        {content.subtitle}
      </p>
    </div>

    <form id="copa-login-form" class="space-y-5" novalidate autocomplete="on">
      <div>
        <label
          for="copa-login-email"
          class="block text-sm font-semibold text-gray-800 mb-1.5"
        >
          {content.emailLabel}
        </label>
        <input
          id="copa-login-email"
          name="email"
          type="email"
          inputmode="email"
          autocomplete="email"
          required
          placeholder={content.emailPlaceholder}
          class="w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-base text-gray-900 placeholder:text-gray-400 focus:outline-none focus:border-[#117CD9] focus:ring-2 focus:ring-[#117CD9]/30 transition"
        />
      </div>

      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label
            for="copa-login-password"
            class="block text-sm font-semibold text-gray-800"
          >
            {content.passwordLabel}
          </label>
          <!-- <a
            href="/copa-oautos-2026/recuperar-password"
            class="text-xs font-medium text-[#117CD9] hover:underline"
          >
            {content.forgotPassword}
          </a> -->
        </div>
        <div class="relative">
          <input
            id="copa-login-password"
            name="password"
            type="password"
            autocomplete="current-password"
            required
            minlength={6}
            placeholder={content.passwordPlaceholder}
            class="w-full rounded-xl border border-gray-300 bg-white px-4 py-3 pr-12 text-base text-gray-900 placeholder:text-gray-400 focus:outline-none focus:border-[#117CD9] focus:ring-2 focus:ring-[#117CD9]/30 transition"
          />
          <button
            type="button"
            id="copa-login-toggle"
            aria-label="Mostrar u ocultar contraseña"
            class="absolute inset-y-0 right-0 flex items-center px-3 text-gray-500 hover:text-[#117CD9] transition"
          >
            <svg
              id="copa-login-eye"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-5 h-5"
            >
              <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
          </button>
        </div>
      </div>

      <p
        id="copa-login-error"
        role="alert"
        class="hidden text-sm text-red-600 bg-red-50 border border-red-100 rounded-lg px-3 py-2"
      >
      </p>

      <button
        type="submit"
        class="block w-full px-10 py-3 rounded-full text-base font-semibold border-2 border-[#117CD9] bg-[#117CD9] text-white hover:bg-[#0D5FB3] hover:border-[#0D5FB3] transition-all duration-300"
      >
        {content.submit}
      </button>
    </form>

    <p class="mt-6 text-center text-sm text-gray-600">
      {content.helper}{" "}
      <a
        href="/copa-oautos-2026"
        class="font-semibold text-[#117CD9] hover:underline"
      >
        Conoce la Copa
      </a>
    </p>

    <p class="mt-8 text-center text-xs text-gray-400">
      {content.footnote}
    </p>
  </div>
</section>

<script is:inline define:vars={{ successRedirect: content.successRedirect, endpointLoginUser: AUTH_ENDPOINTS.loginUser, endpointMagicToken: AUTH_ENDPOINTS.magicTokenLogin }}>
  (() => {

    const STORAGE_KEY = "copa_auth_token";

    // Si ya hay sesión activa y no viene un magic token, ir directo al dashboard.
    const params = new URLSearchParams(window.location.search);
    const magicToken = params.get("token");

    if (!magicToken && localStorage.getItem(STORAGE_KEY)) {
      window.location.replace(successRedirect);
      return;
    }

    function saveTokenAndRedirect(token, viaToken) {
      localStorage.setItem(STORAGE_KEY, token);
      if (viaToken) sessionStorage.setItem("copa_via_token", "1");
      window.location.replace(successRedirect);
    }

    function showError(msg) {
      const errorEl = document.getElementById("copa-login-error");
      if (!errorEl) return;
      errorEl.textContent = msg;
      errorEl.classList.remove("hidden");
    }

    function setLoading(loading) {
      const btn = document.querySelector("#copa-login-form button[type='submit']");
      if (!btn) return;
      btn.disabled = loading;
      btn.textContent = loading ? "Ingresando…" : btn.getAttribute("data-label") || "Ingresar";
    }

    // --- Magic token: si llega ?token=xxx en la URL, login automático ---
    if (magicToken) {
      const spinner = document.getElementById("copa-token-spinner");
      if (spinner) spinner.classList.remove("hidden");

      fetch(endpointMagicToken, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ token: magicToken }),
      })
        .then(function (res) { return res.json(); })
        .then(function (data) {
          if (data && data.success && data.data && data.data.token) {
            saveTokenAndRedirect(data.data.token, true);
          } else {
            const msg =
              (data && data.message) ||
              "El enlace de acceso no es válido o ya expiró.";
            showError(msg);
            if (spinner) spinner.classList.add("hidden");
          }
        })
        .catch(function () {
          showError("No se pudo procesar el enlace de acceso. Intenta más tarde.");
          if (spinner) spinner.classList.add("hidden");
        });

      return; // No inicializar el formulario mientras se procesa el magic token.
    }

    // --- Formulario de login normal ---
    const form = document.getElementById("copa-login-form");
    const toggle = document.getElementById("copa-login-toggle");
    const passwordInput = document.getElementById("copa-login-password");
    const submitBtn = form && form.querySelector("button[type='submit']");

    if (submitBtn) {
      submitBtn.setAttribute("data-label", submitBtn.textContent.trim());
    }

    if (toggle && passwordInput) {
      toggle.addEventListener("click", function () {
        const isPassword = passwordInput.getAttribute("type") === "password";
        passwordInput.setAttribute("type", isPassword ? "text" : "password");
      });
    }

    if (form) {
      form.addEventListener("submit", function (event) {
        event.preventDefault();

        const errorEl = document.getElementById("copa-login-error");
        if (errorEl) {
          errorEl.classList.add("hidden");
          errorEl.textContent = "";
        }

        const formData = new FormData(form);
        const email = String(formData.get("email") || "").trim();
        const password = String(formData.get("password") || "");

        if (!email || !password) {
          showError("Por favor completa todos los campos.");
          return;
        }

        setLoading(true);

        fetch(endpointLoginUser, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email: email, password: password, origin: "web" }),
        })
          .then(function (res) { return res.json(); })
          .then(function (data) {
            if (data && data.success && data.data && data.data.token) {
              saveTokenAndRedirect(data.data.token);
            } else {
              const msg =
                (data && data.message) ||
                "Correo o contraseña incorrectos. Verifica tus datos.";
              showError(msg);
              setLoading(false);
            }
          })
          .catch(function () {
            showError("No se pudo conectar con el servidor. Intenta más tarde.");
            setLoading(false);
          });
      });
    }
  })();
</script>
