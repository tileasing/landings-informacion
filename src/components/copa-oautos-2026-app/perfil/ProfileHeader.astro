---
import type { CopaAppProfileContent } from "../../../content/copa-oautos-2026-app";

interface Props {
  header: CopaAppProfileContent["header"];
  backLabel: string;
  backHref: string;
}

const { header, backLabel, backHref } = Astro.props;
---

<section
  class="relative overflow-hidden bg-gradient-to-br from-[#0a1d36] via-[#1F4368] to-[#0a1d36] text-white"
>
  <div class="absolute inset-0 bg-black/30" aria-hidden="true"></div>

  <div class="relative z-10 max-w-[1200px] mx-auto px-4 sm:px-6 py-8 sm:py-12">
    <a
      href={backHref}
      class="inline-flex items-center gap-1.5 text-sm text-white/80 hover:text-white transition mb-4"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="w-4 h-4"
        aria-hidden="true"
      >
        <path d="m15 18-6-6 6-6"></path>
      </svg>
      {backLabel}
    </a>

    <h1
      class="text-3xl sm:text-4xl md:text-5xl font-extrabold leading-tight drop-shadow-sm"
    >
      {header.title}
    </h1>
    <p
      class="mt-3 text-base sm:text-lg text-white/85 leading-relaxed max-w-3xl"
    >
      {header.subtitle}
    </p>
  </div>
</section>
