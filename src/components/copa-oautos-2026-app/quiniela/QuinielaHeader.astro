---
import type { CopaQuinielaContent } from "../../../content/copa-oautos-2026-app";

interface Props {
  header: CopaQuinielaContent["header"];
  rules: CopaQuinielaContent["rules"];
  backLabel: string;
  backHref: string;
}

const { header, rules, backLabel, backHref } = Astro.props;
---

<section
  class="relative overflow-hidden bg-gradient-to-br from-[#0D2C4D] via-[#117CD9] to-[#0D2C4D] text-white"
  data-quiniela-header
>
  <div class="absolute inset-0 bg-black/30" aria-hidden="true"></div>

  <div class="relative z-10 max-w-[1200px] mx-auto px-4 sm:px-6 py-8 sm:py-12">
    <a
      href={backHref}
      class="inline-flex items-center gap-1.5 text-sm text-white/80 hover:text-white transition mb-4"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="w-4 h-4"
        aria-hidden="true"
      >
        <path d="m15 18-6-6 6-6"></path>
      </svg>
      {backLabel}
    </a>

    <h1
      class="text-3xl sm:text-4xl md:text-5xl font-extrabold leading-tight drop-shadow-sm"
    >
      {header.title}
    </h1>
    <p
      class="mt-3 text-base sm:text-lg text-white/85 leading-relaxed max-w-3xl"
    >
      {header.subtitle}
    </p>

    <div
      class="mt-6 sm:mt-8 bg-white/10 backdrop-blur-sm border border-white/20 rounded-2xl p-4 sm:p-5"
    >
      <div class="flex items-start gap-3">
        <span
          class="flex-shrink-0 mt-0.5 flex h-8 w-8 items-center justify-center rounded-full bg-white/15"
          aria-hidden="true"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="w-4 h-4"
          >
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M12 16v-4"></path>
            <path d="M12 8h.01"></path>
          </svg>
        </span>
        <div class="flex-1 min-w-0">
          <details id="copa-rules-details" class="copa-rules-details">
            <summary
              class="flex items-center justify-between gap-3 cursor-pointer md:cursor-default list-none [&::-webkit-details-marker]:hidden"
            >
              <p class="text-sm sm:text-base font-semibold">
                {rules.title}
              </p>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="copa-rules-chevron w-4 h-4 text-white/70 transition-transform duration-200 md:hidden"
                aria-hidden="true"
              >
                <path d="m6 9 6 6 6-6"></path>
              </svg>
            </summary>
            <ul class="space-y-1.5 mt-2 md:mt-3">
              {
                rules.items.map((item) => (
                  <li class="text-sm text-white/90 leading-relaxed flex items-start gap-2">
                    <span
                      class="mt-1 inline-block h-1.5 w-1.5 rounded-full bg-white/60 flex-shrink-0"
                      aria-hidden="true"
                    />
                    <span>{item}</span>
                  </li>
                ))
              }
            </ul>
          </details>

          <button
            type="button"
            data-open-points-modal
            class="mt-4 inline-flex items-center gap-2 rounded-full bg-white text-[#0D2C4D] hover:bg-white/90 transition px-4 py-2 text-sm font-semibold shadow"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-4 h-4"
              aria-hidden="true"
            >
              <path d="M4 19h16"></path>
              <path d="M4 15h16"></path>
              <path d="M4 11h16"></path>
              <path d="M4 7h16"></path>
            </svg>
            Ver tabla de puntos
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const details = document.getElementById("copa-rules-details");
    if (!details) return;
    const chevron = details.querySelector(".copa-rules-chevron");
    const mq = window.matchMedia("(min-width: 768px)");
    const sync = () => {
      details.open = mq.matches;
    };
    sync();
    mq.addEventListener("change", sync);
    details.addEventListener("toggle", () => {
      if (!chevron) return;
      chevron.classList.toggle("rotate-180", details.open);
    });
  })();
</script>
