---
import type { CopaQuinielaMainTab } from "../../../content/copa-oautos-2026-app";

interface Props {
  tabs: CopaQuinielaMainTab[];
  activeId: string;
}

const { tabs, activeId } = Astro.props;
---

<nav
  aria-label="Secciones de la quiniela"
  class="bg-white border-b border-gray-200 sticky top-16 z-30 shadow-sm"
>
  <div class="max-w-[1200px] mx-auto px-2 sm:px-6">
    <div
      class="flex gap-1 overflow-x-auto no-scrollbar"
      role="tablist"
      id="copa-quiniela-main-tablist"
    >
      {
        tabs.map((tab) => {
          const isActive = tab.id === activeId;
          return (
            <button
              type="button"
              role="tab"
              data-main-tab-id={tab.id}
              aria-selected={isActive ? "true" : "false"}
              aria-controls={`copa-quiniela-main-${tab.id}`}
              class:list={[
                "copa-main-tab relative flex items-center gap-2 whitespace-nowrap px-3 sm:px-5 py-3 sm:py-4 text-sm sm:text-base font-semibold transition border-b-2",
                isActive
                  ? "border-[#117CD9] text-[#117CD9]"
                  : "border-transparent text-gray-500 hover:text-[#117CD9]",
              ]}
            >
              <span
                class:list={[
                  "flex h-7 w-7 items-center justify-center rounded-lg transition",
                  isActive
                    ? "bg-[#117CD9]/10 text-[#117CD9]"
                    : "bg-gray-100 text-gray-500",
                ]}
                aria-hidden="true"
              >
                {tab.icon === "ball" && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="w-4 h-4"
                  >
                    <circle cx="12" cy="12" r="10" />
                    <path d="M12 8.5 8.5 11l1.3 4h4.4l1.3-4z" />
                    <path d="M12 8.5 15.5 11" />
                    <path d="m9.8 15-1.8 2.6" />
                    <path d="m14.2 15 1.8 2.6" />
                  </svg>
                )}
                {tab.icon === "star" && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    class="w-4 h-4"
                  >
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                  </svg>
                )}
              </span>
              <span>{tab.label}</span>
            </button>
          );
        })
      }
    </div>
  </div>
</nav>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
