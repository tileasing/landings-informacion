---
import type { CopaAppRankingContent } from "../../content/copa-oautos-2026-app";

interface Props {
  content: CopaAppRankingContent;
}

const { content } = Astro.props;
const { currentUser, pointsSuffix } = content;

// Mostramos los primeros 5 del ranking. El backend puede mandar más entradas;
// si queremos mostrar más, solo cambiamos este número.
const visibleEntries = content.topEntries.slice(0, 5);
const userInTop = visibleEntries.some(
  (entry) => entry.position === currentUser.position,
);
const topEntries = visibleEntries;

const positionBadge = (pos: number, isCurrent: boolean) => {
  if (isCurrent) {
    return "bg-[#117CD9] text-white";
  }
  if (pos === 1) return "bg-amber-400 text-amber-950";
  if (pos === 2) return "bg-gray-300 text-gray-800";
  if (pos === 3) return "bg-orange-400 text-orange-950";
  return "bg-gray-100 text-gray-600";
};
---

<div
  class="bg-white rounded-3xl shadow-xl ring-1 ring-black/5 p-5 sm:p-6 flex flex-col h-full"
>
  <header class="mb-4">
    <span
      class="block text-[11px] sm:text-xs font-semibold uppercase tracking-[0.2em] text-[#117CD9] mb-1"
    >
      {content.eyebrow}
    </span>
    <h2 class="text-lg sm:text-xl font-extrabold text-[#0D2C4D]">
      {content.title}
    </h2>
    <p class="mt-1 text-xs sm:text-sm text-gray-600">
      {content.subtitle}
    </p>
  </header>

  <ol class="space-y-1 flex-1">
    {
      topEntries.map((entry) => {
        const isCurrent = entry.position === currentUser.position;
        return (
          <li
            class:list={[
              "flex items-center gap-2.5 px-2 py-1.5 rounded-xl transition",
              isCurrent
                ? "bg-[#117CD9]/10 ring-1 ring-[#117CD9]/20"
                : "hover:bg-gray-50",
            ]}
          >
            <span
              class:list={[
                "flex-shrink-0 flex h-7 w-7 items-center justify-center rounded-lg font-extrabold text-xs",
                positionBadge(entry.position, isCurrent),
              ]}
              aria-hidden="true"
            >
              {entry.position}
            </span>

            <span
              class:list={[
                "flex-1 min-w-0 text-xs sm:text-sm truncate",
                isCurrent
                  ? "font-bold text-[#0D2C4D]"
                  : "font-medium text-gray-800",
              ]}
            >
              {entry.name}
            </span>
            <span
              class:list={[
                "text-xs sm:text-sm font-bold tabular-nums whitespace-nowrap",
                isCurrent ? "text-[#0D5FB3]" : "text-gray-700",
              ]}
            >
              {entry.points.toLocaleString("es-MX")}
              <span class="text-[10px] text-gray-400 font-medium ml-0.5">
                {pointsSuffix}
              </span>
            </span>
          </li>
        );
      })
    }
  </ol>

  {
    !userInTop && (
      <div class="mt-4 pt-4 border-t border-gray-100">
        <p class="text-[10px] sm:text-xs font-semibold uppercase tracking-wider text-gray-500 mb-2">
          {content.yourPositionLabel}
        </p>
        <div class="flex items-center gap-2.5 px-2 py-1.5 rounded-xl bg-[#117CD9]/10 ring-1 ring-[#117CD9]/20">
          <span
            class="flex-shrink-0 flex h-7 min-w-[2rem] px-1.5 items-center justify-center rounded-lg font-extrabold text-xs bg-[#117CD9] text-white"
            aria-hidden="true"
          >
            {currentUser.position}
          </span>

          <span class="flex-1 min-w-0 text-xs sm:text-sm font-bold text-[#0D2C4D] truncate">
            {currentUser.name}
          </span>
          <span class="text-xs sm:text-sm font-bold text-[#0D5FB3] tabular-nums whitespace-nowrap">
            {currentUser.points.toLocaleString("es-MX")}
            <span class="text-[10px] text-[#117CD9]/70 font-medium ml-0.5">
              {pointsSuffix}
            </span>
          </span>
        </div>
        <p class="mt-2 text-[11px] sm:text-xs text-gray-500 leading-relaxed">
          {content.notInTopMessage}
        </p>
      </div>
    )
  }

  {
    userInTop && (
      <div class="mt-4 pt-4 border-t border-gray-100">
        <p class="text-[11px] sm:text-xs text-emerald-700 bg-emerald-50 rounded-lg px-3 py-2 font-semibold flex items-center gap-2">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="w-3.5 h-3.5 flex-shrink-0"
            aria-hidden="true"
          >
            <path d="M20 6 9 17l-5-5" />
          </svg>
          {content.inTopMessage}
        </p>
      </div>
    )
  }
</div>
