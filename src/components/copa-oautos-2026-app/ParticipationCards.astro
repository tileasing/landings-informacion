---
import type { CopaAppDashboardContent } from "../../content/copa-oautos-2026-app";

interface Props {
  content: CopaAppDashboardContent;
}

const { content } = Astro.props;

// Importa dinámicamente las imágenes de banner desde src/assets para que Astro
// las procese (hash + optimización). Si el archivo no existe, queda undefined
// y el banner se muestra con el fallback de gradiente.
const bannerImages = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/*.{jpg,jpeg,png,webp,svg}",
  { eager: true },
);

const resolveBanner = (filename: string): string | undefined => {
  const entry = Object.entries(bannerImages).find(([path]) =>
    path.endsWith(`/${filename}`),
  );
  return entry?.[1].default.src;
};

const accentClasses = {
  blue: {
    card: "from-[#117CD9] to-[#0D5FB3]",
    bannerOverlay: "from-[#0D5FB3] via-[#0D5FB3]/70 to-[#117CD9]/30",
    pill: "bg-white/20 text-white",
    button:
      "bg-white text-[#0D5FB3] hover:bg-[#E6F1FB] focus-visible:ring-white/60",
    glow: "bg-white/10",
  },
  green: {
    card: "from-[#5F8750] to-[#3F5E33]",
    bannerOverlay: "from-[#3F5E33] via-[#3F5E33]/70 to-[#5F8750]/30",
    pill: "bg-white/20 text-white",
    button:
      "bg-white text-[#3F5E33] hover:bg-[#EAF1E5] focus-visible:ring-white/60",
    glow: "bg-white/10",
  },
};
---

<section class="bg-[#F4F7FB] text-gray-900">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 py-10 sm:py-14">
    <div class="text-center sm:text-left mb-8 sm:mb-10">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-[#0D2C4D]">
        {content.cardsTitle}
      </h2>
      <p class="mt-2 text-sm sm:text-base text-gray-600 max-w-2xl">
        {content.cardsSubtitle}
      </p>
    </div>

    <div class="grid gap-5 sm:gap-6 md:grid-cols-2">
      {
        content.cards.map((card) => {
          const styles = accentClasses[card.accent];
          const bannerSrc = resolveBanner(card.bannerImage);
          return (
            <a
              href={card.href}
              class:list={[
                "group relative overflow-hidden rounded-3xl text-white shadow-xl bg-gradient-to-br transition-transform duration-300 hover:-translate-y-1 hover:shadow-2xl focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-[#117CD9]/40 flex flex-col",
                styles.card,
              ]}
            >
              {/* Banner con imagen + overlay + pill + título */}
              <div class="relative h-44 sm:h-52 overflow-hidden">
                {bannerSrc ? (
                  <img
                    src={bannerSrc}
                    alt={card.bannerAlt ?? ""}
                    class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                  />
                ) : (
                  <div
                    class:list={[
                      "absolute inset-0 bg-gradient-to-br",
                      styles.card,
                    ]}
                    aria-hidden="true"
                  />
                )}
                <div
                  class:list={[
                    "absolute inset-0 bg-gradient-to-t",
                    styles.bannerOverlay,
                  ]}
                  aria-hidden="true"
                />
                <div class="relative z-10 h-full flex flex-col justify-end p-5 sm:p-6">
                  <span
                    class:list={[
                      "self-start inline-flex items-center gap-1 px-3 py-1 rounded-full text-[11px] font-semibold uppercase tracking-wider backdrop-blur-sm mb-2",
                      styles.pill,
                    ]}
                  >
                    {card.eyebrow}
                  </span>
                  <h3 class="text-3xl sm:text-4xl font-extrabold leading-tight drop-shadow-sm">
                    {card.title}
                  </h3>
                </div>
              </div>

              {/* Body */}
              <div class="relative z-10 flex flex-col flex-1 p-5 sm:p-6">
                <span
                  class:list={[
                    "pointer-events-none absolute -bottom-20 -left-10 w-48 h-48 rounded-full blur-3xl opacity-50",
                    styles.glow,
                  ]}
                  aria-hidden="true"
                />
                <p class="relative text-sm sm:text-base text-white/90 leading-relaxed mb-4">
                  {card.description}
                </p>

                <ul class="relative space-y-2 mb-6">
                  {card.highlights.map((highlight) => (
                    <li class="flex items-start gap-2 text-xs sm:text-sm text-white/90 leading-relaxed">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="3"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="w-4 h-4 mt-0.5 flex-shrink-0 text-white"
                        aria-hidden="true"
                      >
                        <path d="M20 6 9 17l-5-5" />
                      </svg>
                      <span>{highlight}</span>
                    </li>
                  ))}
                </ul>

                <div class="relative mt-auto">
                  <span
                    class:list={[
                      "inline-flex items-center gap-2 px-6 py-3 rounded-full text-sm sm:text-base font-semibold transition-all duration-300 focus-visible:outline-none focus-visible:ring-4",
                      styles.button,
                    ]}
                  >
                    {card.cta}
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1"
                      aria-hidden="true"
                    >
                      <path d="M5 12h14" />
                      <path d="m12 5 7 7-7 7" />
                    </svg>
                  </span>
                </div>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</section>
