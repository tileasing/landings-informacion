---
import type { FooterLink } from "../../content/types";

interface Props {
  logo?: string;
  logoAlt?: string;
  description?: string;
  legalTitle?: string;
  legalLinks?: FooterLink[];
  contactTitle?: string;
  contactItems?: string[];
  copyright?: string;
  disclaimer?: string;
}

const {
  logo = "/logo-oautos.svg",
  logoAlt = "Oautos Inversionistas",
  description = "Plataforma de inversión en pagarés digitales respaldados por activos automotrices",
  legalTitle = "Legal",
  legalLinks = [
    { label: "Términos y Condiciones", href: "#" },
    { label: "Aviso de Privacidad", href: "#" },
    { label: "Preguntas Frecuentes", href: "#" },
  ],
  contactTitle = "Contacto",
  contactItems = [
    "contacto@oautos.com",
    "55 1234 5678",
    "Ciudad de México",
  ],
  copyright = "© 2026 Oautos Inversiones. Todos los derechos reservados.",
  disclaimer = "Aviso: Las inversiones conllevan riesgos. Lee el prospecto antes de invertir.",
} = Astro.props;
---

<footer class="bg-white pt-16 pb-8">
  <div class="max-w-[1200px] mx-auto px-5">

    <!-- Contenido superior -->
    <div class="flex flex-col lg:flex-row justify-between items-start gap-10 lg:gap-0 mb-12">

      <!-- Logo y descripción -->
      <div class="max-w-md">
        <img src={logo} alt={logoAlt} class="h-20 lg:h-28 mb-6" />
        <p class="text-gray-500 leading-relaxed">
          {description}
        </p>
      </div>

      <!-- Links -->
      <div class="flex gap-12 lg:gap-24">
        <!-- Legal -->
        <div>
          <h4 class="font-bold text-gray-900 mb-4">{legalTitle}</h4>
          <ul class="space-y-3">
            {legalLinks.map((link) => (
              <li>
                <a href={link.href} class="text-gray-500 hover:text-primary transition-colors">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Contacto -->
        <div>
          <h4 class="font-bold text-gray-900 mb-4">{contactTitle}</h4>
          <ul class="space-y-3">
            {contactItems.map((item) => (
              <li><span class="text-gray-500">{item}</span></li>
            ))}
          </ul>
        </div>
      </div>

    </div>

    <!-- Línea divisora -->
    <div class="border-t border-gray-200 pt-8 text-center">
      <p class="text-gray-500 text-sm mb-2">{copyright}</p>
      <p class="text-gray-400 text-xs">{disclaimer}</p>
    </div>

  </div>
</footer>
