---
import type { FooterLink } from "../../content/types";
import logoOautos from "../../assets/logo Oautos.png";

interface Props {
  logo?: string;
  logoAlt?: string;

  legalTitle?: string;
  legalLinks?: FooterLink[];
  contactTitle?: string;
  contactItems?: string[];
  copyright?: string;
}

const {
  logo = logoOautos.src,
  logoAlt = "Oautos Inversionistas",

  legalTitle = "Legal",
  legalLinks = [
    { label: "Términos y Condiciones", href: "https://oautos.com.mx/terminos-y-condiciones/" },
    { label: "Aviso de Privacidad", href: "https://oautos.com.mx/aviso-de-privacidad/" },
  ],
  contactTitle = "Contacto",
  contactItems = ["soporte@oautos.com.mx", "Ciudad de México"],
  copyright = "© 2026 Oautos. Todos los derechos reservados.",
} = Astro.props;
---

<footer class="bg-white pt-16 pb-8">
  <div class="max-w-[1200px] mx-auto px-5">
    <!-- Contenido superior -->
    <div
      class="flex flex-col lg:flex-row justify-between items-start gap-10 lg:gap-0 mb-12"
    >
      <!-- Logo + enlace al sitio principal -->
      <div class="max-w-md">
        <img src={logo} alt={logoAlt} class="h-20 lg:h-28" />
        <a
          href="https://oautos.com.mx/"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-flex items-center gap-1.5 text-sm text-gray-500 hover:text-primary transition-colors"
        >
          oautos.com.mx
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="w-3.5 h-3.5"
            aria-hidden="true"
          >
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
            <polyline points="15 3 21 3 21 9" />
            <line x1="10" y1="14" x2="21" y2="3" />
          </svg>
        </a>
      </div>

      <!-- Links -->
      <div class="flex gap-12 lg:gap-24">
        <!-- Legal -->
        <div>
          <h4 class="font-bold text-gray-900 mb-4">{legalTitle}</h4>
          <ul class="space-y-3">
            {
              legalLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-gray-500 hover:text-primary transition-colors"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Contacto -->
        <div>
          <h4 class="font-bold text-gray-900 mb-4">{contactTitle}</h4>
          <ul class="space-y-3">
            {
              contactItems.map((item) => (
                <li>
                  <span class="text-gray-500">{item}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <!-- Línea divisora -->
    <div class="border-t border-gray-200 pt-8 text-center">
      <p class="text-gray-500 text-sm">{copyright}</p>
    </div>
  </div>
</footer>
