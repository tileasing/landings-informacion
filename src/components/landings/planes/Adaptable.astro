---
import type { AdaptableSection } from '../../../content/planes';

type Props = AdaptableSection;

const { title, paragraphs, note } = Astro.props;
---

<section
  aria-labelledby="adaptable-title"
  class="relative overflow-hidden bg-gradient-to-br from-primary to-[#0D5FB3] py-16 lg:py-20"
>
  <!-- Decoración: blobs suaves -->
  <div
    class="pointer-events-none absolute -top-24 -right-24 w-96 h-96 bg-white/10 rounded-full blur-3xl"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute -bottom-24 -left-24 w-80 h-80 bg-[#0D5FB3]/60 rounded-full blur-3xl"
    aria-hidden="true"
  ></div>

  <div class="relative max-w-[820px] mx-auto px-5 text-center">

    <h2
      id="adaptable-title"
      class="text-2xl md:text-3xl lg:text-4xl font-bold text-white leading-tight"
    >
      {title}
    </h2>
    <div
      class="mt-4 mb-7 h-1 w-12 bg-white/50 mx-auto rounded-full"
      aria-hidden="true"
    ></div>

    <div class="space-y-4">
      {paragraphs.map((paragraph) => (
        <p class="text-base lg:text-lg text-white/90 leading-relaxed">
          {paragraph}
        </p>
      ))}
    </div>

    <!-- Nota -->
    <div class="mt-8 flex justify-center">
      <div
        class="inline-flex items-center gap-2.5 bg-white/15 backdrop-blur-sm border border-white/25 text-white px-5 py-3 rounded-full max-w-full"
      >
        <svg
          class="w-5 h-5 flex-shrink-0"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
          />
        </svg>
        <span class="text-sm lg:text-base font-medium leading-snug">
          {note}
        </span>
      </div>
    </div>

  </div>
</section>
