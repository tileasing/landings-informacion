---
import type { BenefitsSection } from '../../../content/planes';
import BenefitIcon from './BenefitIcon.astro';

type Props = BenefitsSection;

const { badge, title, description, items, closing } = Astro.props;
---

<section
  id="beneficios-adicionales"
  aria-labelledby="beneficios-adicionales-title"
  class="bg-[#EDF3FA] py-16 lg:py-24"
>
  <div class="max-w-[1100px] mx-auto px-5">

    <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 lg:items-center">

      <!-- Encabezado -->
      <div>
        <span
          class="inline-block bg-[#C9E5F8] text-primary font-semibold text-xs lg:text-sm px-5 py-2 rounded-full"
        >
          {badge}
        </span>
        <h2
          id="beneficios-adicionales-title"
          class="mt-5 text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 leading-tight"
        >
          {title}
        </h2>
        <div
          class="mt-5 h-1 w-16 bg-primary rounded-full"
          aria-hidden="true"
        ></div>
        <p class="mt-6 text-base lg:text-lg text-gray-700 leading-relaxed">
          {description}
        </p>
      </div>

      <!-- Lista de beneficios -->
      <ul class="space-y-3 list-none p-0 m-0">
        {items.map((item) => (
          <li
            class="flex items-center gap-4 bg-white rounded-xl border border-gray-100 p-4 lg:p-5 shadow-sm transition-all duration-300 hover:shadow-md hover:-translate-y-0.5 hover:border-primary/30"
          >
            <span
              class="inline-flex w-11 h-11 rounded-xl bg-primary/10 text-primary items-center justify-center flex-shrink-0"
              aria-hidden="true"
            >
              <BenefitIcon name={item.icon} class="w-6 h-6" />
            </span>
            <span class="text-base lg:text-lg text-gray-800 font-medium leading-snug">
              {item.text}
            </span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Cierre -->
    <p
      class="mt-12 lg:mt-16 text-center text-lg lg:text-xl text-gray-700 font-medium leading-relaxed max-w-2xl mx-auto"
    >
      {closing}
    </p>

  </div>
</section>
