---
import type { ReasonsSection } from "../../../content/planes";

type Props = ReasonsSection;

const { title, items, closing } = Astro.props;
---

<section
  id="por-que-plan"
  aria-labelledby="por-que-plan-title"
  class="bg-white py-16 lg:py-24"
>
  <div class="max-w-[1100px] mx-auto px-5">
    <!-- Encabezado -->
    <header class="text-center mb-12 lg:mb-16">
      <h2
        id="por-que-plan-title"
        class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 leading-tight"
      >
        {title}
      </h2>
      <div
        class="mt-5 h-1 w-16 bg-primary mx-auto rounded-full"
        aria-hidden="true"
      >
      </div>
    </header>

    <!-- Tarjetas -->
    <div class="grid md:grid-cols-2 gap-6 lg:gap-8">
      {
        items.map((item) => (
          <article class="group bg-white rounded-2xl border border-gray-100 shadow-md p-6 lg:p-8 transition-all duration-300 hover:shadow-xl hover:-translate-y-1">
            <header class="mb-5 pb-5 border-b border-gray-100">
              <div class="flex items-center gap-4 mb-4">
                <span
                  class="inline-flex w-12 h-12 rounded-xl bg-gradient-to-br from-primary to-[#0D5FB3] text-white items-center justify-center flex-shrink-0 transition-transform duration-300 group-hover:scale-110 shadow-md shadow-primary/25"
                  aria-hidden="true"
                >
                  {item.icon === "lightbulb" && (
                    <svg
                      class="w-6 h-6"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"
                      />
                    </svg>
                  )}
                  {item.icon === "chart" && (
                    <svg
                      class="w-6 h-6"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
                      />
                    </svg>
                  )}
                </span>
                <h3 class="text-xl lg:text-2xl font-bold text-gray-900">
                  {item.title}
                </h3>
              </div>

              <div class="inline-flex items-center gap-2 bg-primary/10 text-primary px-3 py-1.5 rounded-full">
                <svg
                  class="w-4 h-4 flex-shrink-0"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2.5"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M13 7l5 5m0 0l-5 5m5-5H6"
                  />
                </svg>
                <span class="text-sm lg:text-base font-semibold leading-snug">
                  {item.outcome}
                </span>
              </div>
            </header>

            <p class="text-base text-gray-700 font-medium mb-3">
              {item.itemsLabel}
            </p>
            <ul class="space-y-2 list-none p-0 m-0">
              {item.items.map((bullet) => (
                <li class="flex items-start gap-3">
                  <svg
                    class="mt-1 w-5 h-5 text-primary flex-shrink-0"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    stroke-width="2.5"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M5 13l4 4L19 7"
                    />
                  </svg>
                  <span class="text-base text-gray-700 leading-relaxed">
                    {bullet}
                  </span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>

    <!-- Cierre -->
    <div class="mt-14 lg:mt-20 max-w-2xl mx-auto text-center px-4">
      <p
        class="text-lg lg:text-xl font-bold text-gray-900 leading-relaxed mb-2"
      >
        {closing.headline}
      </p>
      <p class="text-base lg:text-lg text-gray-600 leading-relaxed">
        {closing.body}
      </p>
    </div>
  </div>
</section>
