---
import Button from '../../shared/Button.astro';
import type { ButtonConfig } from '../../../content/types';

interface Props {
  title: string;
  subtitle?: string;
  button: ButtonConfig;
}

const { title, subtitle, button } = Astro.props;
---

<section
  aria-labelledby="cta-banner-title"
  class="relative overflow-hidden bg-gradient-to-br from-primary to-[#0D5FB3] py-16 lg:py-20"
>
  <!-- Decoración: blobs suaves -->
  <div
    class="pointer-events-none absolute -top-24 -right-24 w-96 h-96 bg-white/10 rounded-full blur-3xl"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute -bottom-24 -left-24 w-80 h-80 bg-[#0D5FB3]/60 rounded-full blur-3xl"
    aria-hidden="true"
  ></div>

  <div class="relative max-w-[1100px] mx-auto px-5">
    <div
      class="grid lg:grid-cols-[1fr_auto] gap-8 lg:gap-12 items-center"
    >
      <!-- Texto -->
      <div class="text-center lg:text-left">
        <h2
          id="cta-banner-title"
          class="text-2xl md:text-3xl lg:text-4xl font-bold text-white leading-tight mb-3"
        >
          {title}
        </h2>
        {subtitle && (
          <p class="text-base lg:text-lg text-white/80 leading-relaxed max-w-2xl mx-auto lg:mx-0">
            {subtitle}
          </p>
        )}
      </div>

      <!-- CTA -->
      <div class="flex justify-center lg:justify-end">
        <Button
          variant={button.variant}
          text={button.text}
          href={button.href}
          blank={button.blank}
        />
      </div>
    </div>
  </div>
</section>
