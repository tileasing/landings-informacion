---
import type { TestimonialesSection } from '../../../content/testimoniales';

type Props = TestimonialesSection;

const { title, subtitle, items } = Astro.props;
---

<section
  id="testimonios"
  aria-labelledby="testimonios-title"
  class="bg-white py-16 lg:py-24"
>
  <div class="max-w-[1100px] mx-auto px-5">

    <!-- Encabezado -->
    <header class="text-center mb-12 lg:mb-16">
      <h2
        id="testimonios-title"
        class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 leading-tight"
      >
        {title}
      </h2>
      <div
        class="mt-5 h-1 w-16 bg-primary mx-auto rounded-full"
        aria-hidden="true"
      ></div>
      {subtitle && (
        <p class="mt-5 text-base lg:text-lg text-gray-600 max-w-2xl mx-auto leading-relaxed">
          {subtitle}
        </p>
      )}
    </header>

    <!-- Mosaico: featured + 2 normales -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      {items.map((item, index) => {
        const isFeatured = index === 0;
        return (
          <article
            class:list={[
              'relative rounded-2xl overflow-hidden p-7 lg:p-9 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg',
              isFeatured
                ? 'md:col-span-2 bg-[#EDF3FA] border-2 border-primary/30 shadow-md shadow-primary/10'
                : 'bg-white border border-gray-100 shadow-sm',
            ]}
          >
            <!-- Comilla decorativa de fondo -->
            <span
              class:list={[
                'absolute leading-none font-bold pointer-events-none select-none',
                isFeatured
                  ? '-top-4 right-6 text-[10rem] text-primary/15'
                  : '-top-2 right-4 text-7xl text-primary/10',
              ]}
              aria-hidden="true"
            >
              “
            </span>

            <!-- Pill de tema -->
            <span class="relative inline-flex bg-primary text-white text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full mb-5">
              {item.theme}
            </span>

            <!-- Quote -->
            <p
              class:list={[
                'relative text-gray-800 leading-relaxed font-medium',
                isFeatured
                  ? 'text-xl lg:text-3xl max-w-3xl'
                  : 'text-base lg:text-lg',
              ]}
            >
              “{item.quote}”
            </p>
          </article>
        );
      })}
    </div>
  </div>
</section>
