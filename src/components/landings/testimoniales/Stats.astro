---
import type { StatsSection } from "../../../content/testimoniales";

type Props = StatsSection;

const { title, subtitle, items } = Astro.props;
---

<section
  aria-labelledby="stats-title"
  class="relative overflow-hidden bg-gradient-to-br from-primary to-[#0D5FB3] py-16 lg:py-20"
>
  <!-- Decoración -->
  <div
    class="pointer-events-none absolute -top-24 -right-24 w-96 h-96 bg-white/10 rounded-full blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -bottom-24 -left-24 w-80 h-80 bg-[#0D5FB3]/60 rounded-full blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="relative max-w-275 mx-auto px-5">
    <header class="text-center mb-10 lg:mb-14">
      <h2
        id="stats-title"
        class="text-2xl md:text-3xl lg:text-4xl font-bold text-white leading-tight"
      >
        {title}
      </h2>
      <div
        class="mt-4 h-1 w-12 bg-white/50 mx-auto rounded-full"
        aria-hidden="true"
      >
      </div>
      {
        subtitle && (
          <p class="mt-5 text-base lg:text-lg text-white/85 max-w-2xl mx-auto leading-relaxed">
            {subtitle}
          </p>
        )
      }
    </header>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-6">
      {
        items.map((item) => (
          <div class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-2xl px-5 py-7 lg:py-9 text-center transition-all duration-300 hover:-translate-y-1 hover:bg-white/15">
            <p class="text-4xl md:text-4xl lg:text-4xl font-bold text-white leading-none tracking-tight">
              {item.value}
            </p>
            <p class="mt-3 text-sm lg:text-base text-white/85 font-medium leading-tight">
              {item.label}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
