---
import type { DifferentiatorsSection } from '../../../content/diferencia-oautos';
import DifferentiatorIcon from './DifferentiatorIcon.astro';

type Props = DifferentiatorsSection;

const { title, subtitle, items } = Astro.props;
---

<section
  id="diferenciadores"
  aria-labelledby="diferenciadores-title"
  class="bg-white py-16 lg:py-24"
>
  <div class="max-w-[1100px] mx-auto px-5">

    <!-- Encabezado -->
    <header class="text-center mb-12 lg:mb-16">
      <h2
        id="diferenciadores-title"
        class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 leading-tight"
      >
        {title}
      </h2>
      <div
        class="mt-5 h-1 w-16 bg-primary mx-auto rounded-full"
        aria-hidden="true"
      ></div>
      {subtitle && (
        <p class="mt-5 text-base lg:text-lg text-gray-600 max-w-2xl mx-auto leading-relaxed">
          {subtitle}
        </p>
      )}
    </header>

    <!-- Grid 2x2 -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      {items.map((item) => {
        const onlyDescription = item.description && !item.items;
        return (
          <article
            class="group bg-white rounded-2xl border border-gray-100 shadow-md p-6 lg:p-8 transition-all duration-300 hover:shadow-xl hover:-translate-y-1"
          >
            <header
              class="flex items-center gap-4 mb-5 pb-5 border-b border-gray-100"
            >
              <span
                class="inline-flex w-12 h-12 rounded-xl bg-gradient-to-br from-primary to-[#0D5FB3] text-white items-center justify-center flex-shrink-0 transition-transform duration-300 group-hover:scale-110 shadow-md shadow-primary/25"
                aria-hidden="true"
              >
                <DifferentiatorIcon name={item.icon} class="w-6 h-6" />
              </span>
              <h3 class="text-xl lg:text-2xl font-bold text-gray-900">
                {item.title}
              </h3>
            </header>

            {item.description && (
              <p
                class:list={[
                  'leading-relaxed',
                  onlyDescription
                    ? 'text-lg lg:text-xl text-gray-800 font-medium'
                    : 'text-base text-gray-600 mb-4',
                ]}
              >
                {item.description}
              </p>
            )}

            {item.itemsLabel && (
              <p class="text-base text-gray-700 font-medium mb-3">
                {item.itemsLabel}
              </p>
            )}

            {item.items && item.items.length > 0 && (
              <ul class="space-y-2 list-none p-0 m-0">
                {item.items.map((bullet) => (
                  <li class="flex items-start gap-3">
                    <svg
                      class="mt-1 w-5 h-5 text-primary flex-shrink-0"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      stroke-width="2.5"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M9 5l7 7-7 7"
                      />
                    </svg>
                    <span class="text-base text-gray-700 leading-relaxed">
                      {bullet}
                    </span>
                  </li>
                ))}
              </ul>
            )}
          </article>
        );
      })}
    </div>
  </div>
</section>
