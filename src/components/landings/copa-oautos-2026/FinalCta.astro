---
import Button from "../../shared/Button.astro";
import type { ButtonConfig } from "../../../content/types";

interface Props {
  title: string;
  bullets: string[];
  cta: ButtonConfig;
  image?: {
    src: string;
    alt: string;
  };
}

const { title, bullets, cta, image } = Astro.props;
---

<section
  id="copa-final-cta"
  aria-labelledby="copa-final-cta-title"
  class="relative bg-[#117CD9] pt-8"
>
  <div class="max-w-[1200px] mx-auto px-5">
    <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
      <!-- Texto + CTA -->
      <div class="text-center lg:text-left text-white">
        <h2
          id="copa-final-cta-title"
          class="text-4xl font-extrabold leading-tight mb-8 drop-shadow-sm"
        >
          {title}
        </h2>

        <ul
          class="space-y-3 mb-10 list-none p-0 inline-block text-left lg:block"
        >
          {
            bullets.map((bullet) => (
              <li class="flex items-start gap-3">
                <span
                  class="flex-shrink-0 mt-1 w-6 h-6 rounded-full bg-white/20 backdrop-blur-sm flex items-center justify-center"
                  aria-hidden="true"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="w-3.5 h-3.5"
                  >
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                </span>
                <span class="text-base lg:text-lg text-white leading-relaxed">
                  {bullet}
                </span>
              </li>
            ))
          }
        </ul>

        <div
          class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start"
        >
          <Button
            variant={cta.variant}
            text={cta.text}
            href={cta.href}
            blank={cta.blank}
          />
        </div>
      </div>

      <!-- Imagen -->
      <div>
        {
          image ? (
            <img
              src={image.src}
              alt={image.alt}
              class="w-full h-auto max-w-md mx-auto"
            />
          ) : (
            <div class="aspect-square max-w-md mx-auto bg-white/10 rounded-3xl border-2 border-dashed border-white/30 flex items-center justify-center">
              <span class="text-white/60 font-medium text-sm text-center px-6">
                Imagen pendiente
              </span>
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>
