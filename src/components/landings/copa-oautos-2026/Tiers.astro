---
interface Tier {
  badge: string;
  audience: string;
  benefits: string[];
}

interface PointsRow {
  label: string;
  points: string;
}

interface PointsInfo {
  triggerLabel: string;
  modalTitle: string;
  actionsTitle: string;
  actions: PointsRow[];
  teamBonusTitle: string;
  teamBonus: PointsRow[];
  closing: string[];
}

interface Props {
  eyebrow?: string;
  title: string;
  tiers: Tier[];
  closing: string[];
  image?: {
    src: string;
    alt: string;
  };
  pointsInfo?: PointsInfo;
}

const { eyebrow, title, tiers, closing, image, pointsInfo } = Astro.props;

const tierStyles = [
  {
    badge: "bg-[#C9E5F8] text-primary",
    border: "border-gray-100",
    check: "bg-[#C9E5F8] text-primary",
    ring: "",
  },
  {
    badge: "bg-[#117CD9] text-white",
    border: "border-primary/30",
    check: "bg-[#117CD9] text-white",
    ring: "",
  },
  {
    badge: "bg-gradient-to-r from-[#117CD9] to-[#5F8750] text-white shadow-sm",
    border: "border-[#5F8750]/40",
    check: "bg-gradient-to-br from-[#117CD9] to-[#5F8750] text-white",
    ring: "ring-2 ring-[#5F8750]/15",
  },
];
---

<section
  id="copa-tiers"
  class="relative py-20 lg:py-28 bg-gradient-to-b from-[#F5F8FC] to-white"
>
  <div class="max-w-[1200px] mx-auto px-5">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-12 lg:mb-16">
      {
        eyebrow && (
          <span class="inline-block bg-[#C9E5F8] text-primary font-semibold text-xs lg:text-sm px-5 py-2 rounded-full mb-5">
            {eyebrow}
          </span>
        )
      }
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold leading-tight">
        {title}
      </h2>
    </div>

    <!-- 2 columnas: imagen | tiers -->
    <div class="gap-10 lg:gap-14 items-center mb-14 lg:mb-20">
      <!-- Imagen -->
      <!-- <div>
        {
          image ? (
            <img
              src={image.src}
              alt={image.alt}
              class="w-full h-auto rounded-2xl shadow-md max-w-md mx-auto"
            />
          ) : (
            <div class="aspect-[4/5] max-w-sm mx-auto bg-white rounded-3xl border-2 border-dashed border-primary/30 flex items-center justify-center shadow-sm">
              <span class="text-primary/40 font-medium text-sm text-center px-6">
                Imagen pendiente
              </span>
            </div>
          )
        }
      </div> -->

      <!-- Tiers stack -->
      <div class="space-y-5 grid grid-cols-3 gap-6">
        {
          tiers.map((tier, i) => (
            <article
              class={`relative h-full flex flex-col bg-white rounded-2xl border ${tierStyles[i].border} ${tierStyles[i].ring} p-6 lg:p-7 shadow-sm hover:shadow-lg transition-shadow`}
            >
              <div class="flex items-center gap-3 mb-3">
                <span
                  class={`inline-block ${tierStyles[i].badge} text-xs lg:text-sm font-bold tracking-widest uppercase px-3 py-1.5 rounded-full`}
                >
                  {tier.badge}
                </span>
              </div>

              <p class="text-base lg:text-lg font-semibold text-gray-900 mb-4">
                {tier.audience}
              </p>

              <ul class="space-y-2 list-none p-0">
                {tier.benefits.map((benefit) => (
                  <li class="flex items-start gap-3">
                    <span
                      class={`flex-shrink-0 mt-1 w-5 h-5 rounded-full ${tierStyles[i].check} flex items-center justify-center`}
                      aria-hidden="true"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="3"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="w-3 h-3"
                      >
                        <path d="M20 6 9 17l-5-5" />
                      </svg>
                    </span>
                    <span class="text-sm lg:text-base text-gray-700 leading-relaxed">
                      {benefit}
                    </span>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>

    <!-- Cierre -->
    <div class="text-center max-w-2xl mx-auto space-y-2">
      {
        closing.map((paragraph, i) => {
          const isLast = i === closing.length - 1;
          return isLast ? (
            <p class="text-base lg:text-lg text-gray-700 leading-relaxed pt-2">
              {paragraph}
            </p>
          ) : (
            <p class="text-xl lg:text-2xl font-bold text-gray-900 leading-tight">
              {paragraph}
            </p>
          );
        })
      }

      {
        pointsInfo && (
          <div class="pt-5">
            <button
              type="button"
              data-open-points-modal
              class="inline-flex items-center gap-1.5 text-primary font-semibold text-sm lg:text-base underline underline-offset-4 decoration-primary/40 hover:decoration-primary transition-colors"
            >
              {pointsInfo.triggerLabel}
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="w-4 h-4"
                aria-hidden="true"
              >
                <path d="M5 12h14" />
                <path d="m12 5 7 7-7 7" />
              </svg>
            </button>
          </div>
        )
      }
    </div>
  </div>

  {
    pointsInfo && (
      <dialog
        id="copa-points-modal"
        class="copa-points-dialog backdrop:bg-black/60 backdrop:backdrop-blur-sm rounded-2xl p-0 w-full max-w-2xl bg-transparent border-0"
        aria-labelledby="copa-points-modal-title"
      >
        <div class="relative bg-white rounded-2xl shadow-2xl max-h-[90vh] overflow-y-auto">
          {/* Header */}
          <div class="sticky top-0 bg-white border-b border-gray-100 px-6 lg:px-8 py-5 flex items-start justify-between gap-4">
            <h3
              id="copa-points-modal-title"
              class="text-xl lg:text-2xl font-bold text-gray-900 leading-tight"
            >
              {pointsInfo.modalTitle}
            </h3>
            <button
              type="button"
              data-close-points-modal
              aria-label="Cerrar"
              class="flex-shrink-0 -mr-1 w-9 h-9 rounded-full hover:bg-gray-100 flex items-center justify-center text-gray-500 hover:text-gray-900 transition-colors"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="w-5 h-5"
                aria-hidden="true"
              >
                <path d="M18 6 6 18" />
                <path d="m6 6 12 12" />
              </svg>
            </button>
          </div>

          {/* Body */}
          <div class="px-6 lg:px-8 py-6 space-y-8">
            {/* Tabla 1: Acciones */}
            <section>
              <h4 class="text-xs font-bold tracking-widest uppercase text-primary mb-3">
                {pointsInfo.actionsTitle}
              </h4>
              <div class="rounded-xl border border-gray-100 overflow-hidden">
                <div class="grid grid-cols-[1fr_auto] gap-4 px-4 py-2.5 bg-gray-50 border-b border-gray-100">
                  <span class="text-[11px] font-bold tracking-widest uppercase text-gray-500">
                    Acción
                  </span>
                  <span class="text-[11px] font-bold tracking-widest uppercase text-gray-500">
                    Puntos Copa
                  </span>
                </div>
                <ul class="list-none p-0 m-0 divide-y divide-gray-100">
                  {pointsInfo.actions.map((row) => (
                    <li class="grid grid-cols-[1fr_auto] items-center gap-4 px-4 py-2.5">
                      <span class="text-sm text-gray-800">{row.label}</span>
                      <span class="text-sm font-bold text-primary">
                        {row.points}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            </section>

            {/* Tabla 2: Bonus equipo favorito */}
            <section>
              <h4 class="text-xs font-bold tracking-widest uppercase text-[#5F8750] mb-3">
                {pointsInfo.teamBonusTitle}
              </h4>
              <div class="rounded-xl border border-gray-100 overflow-hidden">
                <div class="grid grid-cols-[1fr_auto] gap-4 px-4 py-2.5 bg-gray-50 border-b border-gray-100">
                  <span class="text-[11px] font-bold tracking-widest uppercase text-gray-500">
                    Resultado
                  </span>
                  <span class="text-[11px] font-bold tracking-widest uppercase text-gray-500">
                    Puntos Copa
                  </span>
                </div>
                <ul class="list-none p-0 m-0 divide-y divide-gray-100">
                  {pointsInfo.teamBonus.map((row) => (
                    <li class="grid grid-cols-[1fr_auto] items-center gap-4 px-4 py-2.5">
                      <span class="text-sm text-gray-800">{row.label}</span>
                      <span class="text-sm font-bold text-[#5F8750]">
                        {row.points}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            </section>

            {/* Cierre informativo */}
            <div class="bg-[#EDF3FA] rounded-xl p-4 lg:p-5 border-l-4 border-primary">
              {pointsInfo.closing.map((p) => (
                <p class="text-sm lg:text-base text-gray-800 leading-relaxed">
                  {p}
                </p>
              ))}
            </div>
          </div>
        </div>
      </dialog>
    )
  }
</section>

<style is:global>
  .copa-points-dialog {
    margin: auto;
  }
  .copa-points-dialog[open] {
    animation: copa-points-modal-in 200ms ease-out;
  }
  @keyframes copa-points-modal-in {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
</style>

<script is:inline>
  (() => {
    const dlg = document.getElementById("copa-points-modal");
    if (!dlg) return;
    const openBtn = document.querySelector("[data-open-points-modal]");
    const closeBtn = dlg.querySelector("[data-close-points-modal]");

    openBtn?.addEventListener("click", () => {
      if (typeof dlg.showModal === "function") {
        dlg.showModal();
        document.body.style.overflow = "hidden";
      }
    });
    closeBtn?.addEventListener("click", () => dlg.close());
    // Click en backdrop cierra el modal
    dlg.addEventListener("click", (e) => {
      const rect = dlg.getBoundingClientRect();
      const inDialog =
        rect.top <= e.clientY &&
        e.clientY <= rect.bottom &&
        rect.left <= e.clientX &&
        e.clientX <= rect.right;
      if (!inDialog) dlg.close();
    });
    dlg.addEventListener("close", () => {
      document.body.style.overflow = "";
    });
  })();
</script>
