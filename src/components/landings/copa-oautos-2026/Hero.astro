---
import Button from "../../shared/Button.astro";
import type { ButtonConfig } from "../../../content/types";
import logoOautos from "../../../assets/logoOautos-copa.png";

interface Props {
  title: string;
  subtitle: string;
  cta: ButtonConfig;
  appStores?: {
    playStore?: string;
    appStore?: string;
  };
  backgroundImage?: {
    src: string;
    alt?: string;
  };
}

const { title, subtitle, cta, appStores, backgroundImage } = Astro.props;
---

<section
  id="copa-hero"
  class="relative min-h-dvh w-full flex items-center justify-center overflow-hidden"
>
  <!-- Fondo: imagen + overlay (cuando no hay imagen, fallback con gradiente) -->
  {
    backgroundImage ? (
      <img
        src={backgroundImage.src}
        alt={backgroundImage.alt ?? ""}
        class="absolute inset-0 w-full h-full object-cover opacity-65"
      />
    ) : (
      <div class="absolute inset-0 bg-gradient-to-br from-[#0D2C4D] via-[#117CD9] to-[#0D2C4D]" />
    )
  }
  <div class="absolute inset-0 bg-black/65" aria-hidden="true"></div>

  <!-- Contenido centrado -->
  <div
    class="relative z-10 max-w-250 w-full mx-auto px-5 text-center text-white"
  >
    <img
      src={logoOautos.src}
      alt="Oautos"
      class="h-12 lg:h-16 w-auto mx-auto mb-8 drop-shadow-lg"
    />

    <h1
      class="text-4xl sm:text-5xl font-extrabold leading-tight mb-6 drop-shadow-lg"
    >
      {title}
    </h1>

    <p
      class="text-lg md:text-xl lg:text-2xl text-white/90 leading-relaxed max-w-3xl mx-auto mb-10"
    >
      {subtitle}
    </p>

    <div class="flex justify-center">
      <Button
        variant={cta.variant}
        text={cta.text}
        href={cta.href}
        blank={cta.blank}
      />
    </div>

    {
      appStores && (appStores.playStore || appStores.appStore) && (
        <div class="mt-12 flex flex-col sm:flex-row items-center justify-center gap-3">
          {appStores.playStore && (
            <a
              href={appStores.playStore}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Disponible en Google Play"
              class="inline-flex items-center gap-3 bg-black hover:bg-neutral-800 text-white rounded-xl px-4 py-2.5 border border-white/20 transition-colors w-40"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 512 512"
                class="w-7 h-7 flex-shrink-0"
                aria-hidden="true"
              >
                <path
                  fill="#34A853"
                  d="M325.3 234.3 104.6 13l280.8 161.2-60.1 60.1z"
                />
                <path
                  fill="#FBBC04"
                  d="M104.6 499l280.8-161.2-60.1-60.1L104.6 499z"
                />
                <path
                  fill="#4285F4"
                  d="M47 0C34 6.8 25.3 19.2 25.3 35.3v441.3c0 16.1 8.7 28.5 21.7 35.3l256.6-256L47 0z"
                />
                <path
                  fill="#EA4335"
                  d="M472.2 225.6 413.3 191.5l-65.7 64.5 65.7 64.5 60.1-34.1c18-14.3 18-46.5-1.2-60.8z"
                />
              </svg>
              <span class="flex flex-col items-start leading-tight text-left">
                <span class="text-[10px] uppercase tracking-wider opacity-80">
                  Disponible en
                </span>
                <span class="text-[14px] font-semibold -mt-0.5">
                  Google Play
                </span>
              </span>
            </a>
          )}

          {appStores.appStore && (
            <a
              href={appStores.appStore}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Descarga en App Store"
              class="inline-flex items-center gap-3 bg-black hover:bg-neutral-800 text-white rounded-xl px-4 py-2.5 border border-white/20 transition-colors w-40"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 384 512"
                class="w-6 h-7 flex-shrink-0"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z" />
              </svg>
              <span class="flex flex-col items-start leading-tight text-left">
                <span class="text-[10px] uppercase tracking-wider opacity-80">
                  Descarga en
                </span>
                <span class="text-[14px] font-semibold -mt-0.5">App Store</span>
              </span>
            </a>
          )}
        </div>
      )
    }
  </div>

  <!-- Indicador de scroll -->
  <a
    id="copa-scroll-indicator"
    href="#copa-hero-scroll-target"
    aria-label="Ver más contenido"
    class="hidden md:flex fixed bottom-5 left-5 z-30 flex-col items-center gap-2 text-white/80 hover:text-white transition-all duration-300 group"
  >
    <span
      class="text-[10px] lg:text-xs uppercase tracking-[0.2em] font-semibold"
      >Desliza</span
    >
    <span
      class="w-10 h-10 rounded-full bg-white/15 backdrop-blur-sm border border-white/40 group-hover:border-white shadow-md flex items-center justify-center animate-bounce"
      aria-hidden="true"
    >
      <svg
        class="w-4 h-4"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2.5"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"
        ></path>
      </svg>
    </span>
  </a>
</section>
<span id="copa-hero-scroll-target" class="block" aria-hidden="true"></span>

<script is:inline>
  (() => {
    const el = document.getElementById("copa-scroll-indicator");
    if (!el) return;
    const onScroll = () => {
      if (window.scrollY > window.innerHeight * 0.4) {
        el.style.opacity = "0";
        el.style.pointerEvents = "none";
      } else {
        el.style.opacity = "";
        el.style.pointerEvents = "";
      }
    };
    window.addEventListener("scroll", onScroll, { passive: true });
  })();
</script>
