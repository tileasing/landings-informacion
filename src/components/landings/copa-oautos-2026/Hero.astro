---
import Button from "../../shared/Button.astro";
import type { ButtonConfig } from "../../../content/types";
import logoOautos from "../../../assets/logoOautos-copa.png";

interface Props {
  title: string;
  subtitle: string;
  cta: ButtonConfig;
  backgroundImage?: {
    src: string;
    alt?: string;
  };
}

const { title, subtitle, cta, backgroundImage } = Astro.props;
---

<section
  id="copa-hero"
  class="relative min-h-dvh w-full flex items-center justify-center overflow-hidden"
>
  <!-- Fondo: imagen + overlay (cuando no hay imagen, fallback con gradiente) -->
  {
    backgroundImage ? (
      <img
        src={backgroundImage.src}
        alt={backgroundImage.alt ?? ""}
        class="absolute inset-0 w-full h-full object-cover opacity-65"
      />
    ) : (
      <div class="absolute inset-0 bg-gradient-to-br from-[#0D2C4D] via-[#117CD9] to-[#0D2C4D]" />
    )
  }
  <div class="absolute inset-0 bg-black/65" aria-hidden="true"></div>

  <!-- Contenido centrado -->
  <div
    class="relative z-10 max-w-250 w-full mx-auto px-5 text-center text-white"
  >
    <img
      src={logoOautos.src}
      alt="Oautos"
      class="h-12 lg:h-16 w-auto mx-auto mb-8 drop-shadow-lg"
    />

    <h1
      class="text-4xl sm:text-5xl font-extrabold leading-tight mb-6 drop-shadow-lg"
    >
      {title}
    </h1>

    <p
      class="text-lg md:text-xl lg:text-2xl text-white/90 leading-relaxed max-w-3xl mx-auto mb-10"
    >
      {subtitle}
    </p>

    <div class="flex justify-center">
      <Button
        variant={cta.variant}
        text={cta.text}
        href={cta.href}
        blank={cta.blank}
      />
    </div>
  </div>

  <!-- Indicador de scroll -->
  <a
    id="copa-scroll-indicator"
    href="#copa-hero-scroll-target"
    aria-label="Ver más contenido"
    class="hidden md:flex fixed bottom-5 left-5 z-30 flex-col items-center gap-2 text-white/80 hover:text-white transition-all duration-300 group"
  >
    <span
      class="text-[10px] lg:text-xs uppercase tracking-[0.2em] font-semibold"
      >Desliza</span
    >
    <span
      class="w-10 h-10 rounded-full bg-white/15 backdrop-blur-sm border border-white/40 group-hover:border-white shadow-md flex items-center justify-center animate-bounce"
      aria-hidden="true"
    >
      <svg
        class="w-4 h-4"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2.5"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"
        ></path>
      </svg>
    </span>
  </a>
</section>
<span id="copa-hero-scroll-target" class="block" aria-hidden="true"></span>

<script is:inline>
  (() => {
    const el = document.getElementById("copa-scroll-indicator");
    if (!el) return;
    const onScroll = () => {
      if (window.scrollY > window.innerHeight * 0.4) {
        el.style.opacity = "0";
        el.style.pointerEvents = "none";
      } else {
        el.style.opacity = "";
        el.style.pointerEvents = "";
      }
    };
    window.addEventListener("scroll", onScroll, { passive: true });
  })();
</script>
