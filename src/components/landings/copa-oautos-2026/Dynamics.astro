---
import Button from "../../shared/Button.astro";
import type { ButtonConfig } from "../../../content/types";
import triviaImage from "../../../assets/trivia.png";
import ruletaImage from "../../../assets/ruleta.png";

type DynamicIcon = "lightbulb" | "pie";
type DynamicAccent = "primary" | "secondary";

interface DynamicCard {
  iconKey: DynamicIcon;
  eyebrow: string;
  title: string;
  description: string;
  featuresLabel: string;
  features: string[];
  bonus?: { label: string; text: string };
  timing?: { label: string; items: string[] };
  accent: DynamicAccent;
}

interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  cards: DynamicCard[];
  closing: string;
  cta: ButtonConfig;
  appStores?: {
    playStore?: string;
    appStore?: string;
  };
}

const { eyebrow, title, intro, cards, closing, cta, appStores } = Astro.props;

const iconImages: Record<DynamicIcon, { src: string; alt: string }> = {
  lightbulb: { src: triviaImage.src, alt: "Trivias" },
  pie: { src: ruletaImage.src, alt: "Ruletas" },
};

const accentStyles: Record<
  DynamicAccent,
  {
    header: string;
    eyebrowText: string;
    check: string;
    accentBg: string;
    accentText: string;
  }
> = {
  primary: {
    header: "bg-gradient-to-br from-[#117CD9] to-[#0D5FB3]",
    eyebrowText: "text-white/80",
    check: "bg-[#C9E5F8] text-primary",
    accentBg: "bg-[#EDF3FA]",
    accentText: "text-primary",
  },
  secondary: {
    header: "bg-gradient-to-br from-[#5F8750] to-[#4A6B3F]",
    eyebrowText: "text-white/80",
    check: "bg-[#E5EFE0] text-[#5F8750]",
    accentBg: "bg-[#E5EFE0]",
    accentText: "text-[#5F8750]",
  },
};
---

<section
  id="copa-dynamics"
  class="relative py-20 lg:py-28 bg-gradient-to-b from-white to-[#F5F8FC]"
>
  <div class="max-w-[1200px] mx-auto px-5">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-12 lg:mb-16">
      {
        eyebrow && (
          <span class="inline-block bg-gradient-to-r from-[#117CD9] to-[#5F8750] text-white font-semibold text-xs lg:text-sm px-5 py-2 rounded-full mb-5">
            {eyebrow}
          </span>
        )
      }
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold leading-tight mb-5">
        {title}
      </h2>
      {
        intro && (
          <p class="text-base lg:text-lg text-gray-700 leading-relaxed">
            {intro}
          </p>
        )
      }
    </div>

    <!-- 2 cards -->
    <div class="grid lg:grid-cols-2 gap-6 lg:gap-8">
      {
        cards.map((card) => {
          const style = accentStyles[card.accent];
          return (
            <article class="flex flex-col h-full bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg transition-shadow overflow-hidden">
              {/* Top coloreado */}
              <div class={`${style.header} text-white p-6 lg:p-8`}>
                <div class="flex items-center gap-4">
                  <span class="flex-shrink-0 w-14 h-14 rounded-2xl bg-white/15 backdrop-blur-sm flex items-center justify-center shadow-inner">
                    <img
                      src={iconImages[card.iconKey].src}
                      alt={iconImages[card.iconKey].alt}
                      class="w-10 h-10 object-contain"
                    />
                  </span>
                  <div>
                    <span
                      class={`block text-xs font-bold tracking-widest uppercase mb-1 ${style.eyebrowText}`}
                    >
                      {card.eyebrow}
                    </span>
                    <h3 class="text-xl  font-bold leading-tight">
                      {card.title}
                    </h3>
                  </div>
                </div>
              </div>

              {/* Body */}
              <div class="flex flex-col flex-1 p-6 lg:p-7">
                <p class="text-base text-gray-700 leading-relaxed mb-5">
                  {card.description}
                </p>

                <p class="text-sm font-bold text-gray-900 mb-3">
                  {card.featuresLabel}
                </p>
                <ul class="space-y-2 list-none p-0 m-0 mb-6">
                  {card.features.map((feature) => (
                    <li class="flex items-start gap-3">
                      <span
                        class={`flex-shrink-0 mt-0.5 w-5 h-5 rounded-full ${style.check} flex items-center justify-center`}
                        aria-hidden="true"
                      >
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="3"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          class="w-3 h-3"
                        >
                          <path d="M20 6 9 17l-5-5" />
                        </svg>
                      </span>
                      <span class="text-sm lg:text-base text-gray-700 leading-relaxed">
                        {feature}
                      </span>
                    </li>
                  ))}
                </ul>

                {/* Bloque destacado al pie (bonus o timing) */}
                <div class="mt-auto">
                  {card.bonus && (
                    <div
                      class={`${style.accentBg} rounded-xl p-4 lg:p-5 border border-gray-100`}
                    >
                      <span
                        class={`block text-xs font-bold tracking-widest uppercase ${style.accentText} mb-1.5`}
                      >
                        {card.bonus.label}
                      </span>
                      <p class="text-sm lg:text-base text-gray-800 font-medium leading-relaxed">
                        {card.bonus.text}
                      </p>
                    </div>
                  )}

                  {card.timing && (
                    <div
                      class={`${style.accentBg} rounded-xl p-4 lg:p-5 border border-gray-100`}
                    >
                      <span
                        class={`block text-xs font-bold tracking-widest uppercase ${style.accentText} mb-3`}
                      >
                        {card.timing.label}
                      </span>
                      <ul class="flex flex-wrap gap-2 list-none p-0 m-0">
                        {card.timing.items.map((item) => (
                          <li class="inline-flex items-center gap-2 px-3 py-1.5 bg-white text-gray-800 text-xs font-semibold rounded-full border border-gray-200">
                            <span
                              class={`w-1.5 h-1.5 rounded-full ${style.accentText.replace("text-", "bg-")}`}
                              aria-hidden="true"
                            />
                            {item}
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                </div>
              </div>
            </article>
          );
        })
      }
    </div>

    <!-- Cierre + CTA -->
    <div class="text-center max-w-2xl mx-auto mt-12 lg:mt-14">
      <p
        class="text-base lg:text-lg text-gray-900 font-semibold leading-relaxed mb-6"
      >
        {closing}
      </p>
      <Button
        variant={cta.variant}
        text={cta.text}
        href={cta.href}
        blank={cta.blank}
      />

      {
        appStores && (appStores.playStore || appStores.appStore) && (
          <div class="mt-12 flex flex-col sm:flex-row items-center justify-center gap-3">
            {appStores.playStore && (
              <a
                href={appStores.playStore}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Disponible en Google Play"
                class="inline-flex items-center gap-3 bg-black hover:bg-neutral-800 text-white rounded-xl px-4 py-2.5 border border-white/20 transition-colors w-40"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 512 512"
                  class="w-7 h-7 flex-shrink-0"
                  aria-hidden="true"
                >
                  <path
                    fill="#34A853"
                    d="M325.3 234.3 104.6 13l280.8 161.2-60.1 60.1z"
                  />
                  <path
                    fill="#FBBC04"
                    d="M104.6 499l280.8-161.2-60.1-60.1L104.6 499z"
                  />
                  <path
                    fill="#4285F4"
                    d="M47 0C34 6.8 25.3 19.2 25.3 35.3v441.3c0 16.1 8.7 28.5 21.7 35.3l256.6-256L47 0z"
                  />
                  <path
                    fill="#EA4335"
                    d="M472.2 225.6 413.3 191.5l-65.7 64.5 65.7 64.5 60.1-34.1c18-14.3 18-46.5-1.2-60.8z"
                  />
                </svg>
                <span class="flex flex-col items-start leading-tight text-left">
                  <span class="text-[10px] uppercase tracking-wider opacity-80">
                    Disponible en
                  </span>
                  <span class="text-[14px] font-semibold -mt-0.5">
                    Google Play
                  </span>
                </span>
              </a>
            )}

            {appStores.appStore && (
              <a
                href={appStores.appStore}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Descarga en App Store"
                class="inline-flex items-center gap-3 bg-black hover:bg-neutral-800 text-white rounded-xl px-4 py-2.5 border border-white/20 transition-colors w-40"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 384 512"
                  class="w-6 h-7 flex-shrink-0"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z" />
                </svg>
                <span class="flex flex-col items-start leading-tight text-left">
                  <span class="text-[10px] uppercase tracking-wider opacity-80">
                    Descarga en
                  </span>
                  <span class="text-[14px] font-semibold -mt-0.5">
                    App Store
                  </span>
                </span>
              </a>
            )}
          </div>
        )
      }
    </div>
  </div>
</section>
