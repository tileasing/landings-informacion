---
// Steps Component
import Button from "./Button.astro";

const steps = [
  {
    number: "1",
    title: "Regístrate",
    description: "Completa tu proceso KYC y documentos que se solicitan",
  },
  {
    number: "2",
    title: "Elige tu inversión",
    description:
      "Selecciona el monto y plazo que mejor se ajuste a tus expectativas",
  },
  {
    number: "3",
    title: "Invierte",
    description: "Transfiere tu capital y comienza a generar rendimientos",
  },
];
---

<section id="steps" class="bg-[#0B1F3F] py-20">
  <div class="max-w-[1200px] mx-auto px-5 text-center">
    <!-- Badge -->
    <span
      class="inline-block bg-white/10 text-white text-sm font-medium px-6 py-2 rounded-full mb-6"
    >
      Cómo funciona
    </span>

    <!-- Título -->
    <h2 class="text-3xl lg:text-4xl font-bold text-white mb-4">
      Comienza en 3 simples pasos
    </h2>
    <p class="text-gray-400 text-lg mb-12">Proceso rápido y 100% digital</p>

    <!-- Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
      {
        steps.map((step) => (
          <div class="border border-gray-600 rounded-2xl p-10 text-center transition-all duration-300 hover:-translate-y-2 hover:border-primary/60 hover:shadow-lg hover:shadow-primary/10">
            <div class="w-16 h-16 rounded-full bg-secondary flex items-center justify-center mx-auto mb-6">
              <span class="text-white text-2xl font-bold font-heading">
                {step.number}
              </span>
            </div>
            <h3 class="text-xl font-bold text-white mb-3">{step.title}</h3>
            <p class="text-gray-400 leading-relaxed">{step.description}</p>
          </div>
        ))
      }
    </div>

    <!-- Botón -->
    <Button
      variant="principal"
      text="Comenzar ahora"
      href="https://inversiones.oautos.mx/login"
    />
  </div>
</section>
