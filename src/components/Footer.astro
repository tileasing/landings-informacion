---
// Footer Component
---

<footer class="bg-white pt-16 pb-8">
  <div class="max-w-[1200px] mx-auto px-5">

    <!-- Contenido superior -->
    <div class="flex flex-col lg:flex-row justify-between items-start gap-10 lg:gap-0 mb-12">

      <!-- Logo y descripción -->
      <div class="max-w-md">
        <img src="/logo-oautos.svg" alt="Oautos Inversionistas" class="h-20 lg:h-28 mb-6" />
        <p class="text-gray-500 leading-relaxed">
          Plataforma de inversión en pagarés digitales respaldados por activos automotrices
        </p>
      </div>

      <!-- Links -->
      <div class="flex gap-12 lg:gap-24">
        <!-- Legal -->
        <div>
          <h4 class="font-bold text-gray-900 mb-4">Legal</h4>
          <ul class="space-y-3">
            <li><a href="#" class="text-gray-500 hover:text-primary transition-colors">Términos y Condiciones</a></li>
            <li><a href="#" class="text-gray-500 hover:text-primary transition-colors">Aviso de Privacidad</a></li>
            <li><a href="#" class="text-gray-500 hover:text-primary transition-colors">Preguntas Frecuentes</a></li>
          </ul>
        </div>

        <!-- Contacto -->
        <div>
          <h4 class="font-bold text-gray-900 mb-4">Contacto</h4>
          <ul class="space-y-3">
            <li><span class="text-gray-500">contacto@oautos.com</span></li>
            <li><span class="text-gray-500">55 1234 5678</span></li>
            <li><span class="text-gray-500">Ciudad de México</span></li>
          </ul>
        </div>
      </div>

    </div>

    <!-- Línea divisora -->
    <div class="border-t border-gray-200 pt-8 text-center">
      <p class="text-gray-500 text-sm mb-2">© 2026 Oautos Inversiones. Todos los derechos reservados.</p>
      <p class="text-gray-400 text-xs">Aviso: Las inversiones conllevan riesgos. Lee el prospecto antes de invertir.</p>
    </div>

  </div>
</footer>
