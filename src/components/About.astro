---
// About Component
import Button from "./Button.astro";
---

<section id="about" class="bg-white py-20">
  <div class="max-w-[1200px] mx-auto px-5">
    <div class="flex flex-col lg:flex-row items-center gap-10 lg:gap-16">
      <!-- Imagen -->
      <div class="w-full lg:w-1/2 rounded-2xl overflow-hidden shadow-lg">
        <img
          src="/img_about.png"
          alt="Invierte con flexibilidad total"
          class="w-full transition-transform duration-500 hover:scale-110"
        />
      </div>

      <!-- Contenido -->
      <div class="w-full lg:w-1/2">
        <h2 class="text-3xl lg:text-4xl font-bold mb-6">
          Invierte con<br />flexibilidad total
        </h2>

        <p class="text-gray-500 mb-4">No trabajamos con planes cerrados.</p>

        <p class="text-gray-500 mb-4">
          <span class="font-semibold text-gray-700"
            >Aquí tú defines el monto, el plazo y el nivel de inversión según
            tus objetivos.</span
          >
        </p>

        <p class="text-gray-500 mb-8">
          Nosotros nos encargamos de respaldar tu capital con activos
          automotrices y de que todo el proceso sea seguro, transparente y
          legal.
        </p>

        <Button
          variant="principal"
          text="Comenzar ahora"
          href="https://inversiones.oautos.mx/login"
        />
      </div>
    </div>
  </div>
</section>
